<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StreamAssist.Shell.MainWindowView"
        x:DataType="shell:MainWindowViewModel"

        xmlns:shell="using:StreamAssist.Shell"
        xmlns:mvvm="using:StreamAssist.Core.Mvvm"

        Title="StreamAssist"
        Background="{DynamicResource MainBackground}"
        xmlns:s="using:StreamAssist.Styles">

    <!-- output console | * -->

    <Grid Margin="{s:Gap LineZoneAll}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding OutputConsolePanel.Length, Mode=TwoWay}" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- output console panel -->

        <shell:PanelView Grid.Column="0" DataContext="{Binding OutputConsolePanel}"/>

        <GridSplitter Grid.Column="1" Classes="ColumnSplitter"/>

        <!-- tab strip | * -->

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- the tab buttons: the shown one is purple (Button.Tab.Open). Dragging something over one switches to it
                 (so a block or binding can be carried to another tab), see the code-behind -->

            <ItemsControl Grid.Row="0" Margin="{s:Gap PadAll}" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mvvm:ViewModelTabItem">
                        <Button Classes="Tab" Classes.Open="{Binding IsSelected}" Content="{Binding Label}"
                                Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).TabPressedCommand}"
                                CommandParameter="{Binding}"
                                DragDrop.AllowDrop="True"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1" Classes="Divider"/>

            <!-- * | side panel -->

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="{Binding SidePanel.SplitterLength}"/>
                    <ColumnDefinition Width="{Binding SidePanel.Length, Mode=TwoWay}"
                                      MinWidth="{Binding SidePanel.MinLength}"/>
                </Grid.ColumnDefinitions>

                <!-- main content | bottom panel -->

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="{Binding BottomPanel.SplitterLength}"/>
                        <RowDefinition Height="{Binding BottomPanel.Length, Mode=TwoWay}"
                                       MinHeight="{Binding BottomPanel.MinLength}"/>
                    </Grid.RowDefinitions>

                    <!-- main content -->

                    <ContentControl Grid.Row="0" Content="{Binding ActiveContent}"/>

                    <GridSplitter Grid.Row="1" Classes="RowSplitter"
                                  IsVisible="{Binding BottomPanel.IsShown}"/>

                    <!-- bottom panel -->

                    <shell:PanelView Grid.Row="2" DataContext="{Binding BottomPanel}"/>
                </Grid>

                <GridSplitter Grid.Column="1" Classes="ColumnSplitter"
                              IsVisible="{Binding SidePanel.IsShown}"/>

                <!-- side panel -->

                <shell:PanelView Grid.Column="2" DataContext="{Binding SidePanel}"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
