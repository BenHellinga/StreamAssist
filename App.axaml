<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.App"

             xmlns:local="using:StreamAssist"
             xmlns:configurator="using:StreamAssist.Components.Core.Configurator"

             RequestedThemeVariant="Default">

    <!-- view locator -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- shared resources -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://StreamAssist/Styles/Brushes.axaml"/>
                <ResourceInclude Source="avares://StreamAssist/Styles/Configurator.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- shared styles -->

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls.axaml"/>
    </Application.Styles>

</Application>