<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.App"

             xmlns:local="using:StreamAssist"

             RequestedThemeVariant="Default">

    <!-- view locator: finds FooView for any FooViewModel -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- shared resources -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://StreamAssist/Styles/Resources/Brushes.axaml"/>
                <ResourceInclude Source="avares://StreamAssist/Styles/Resources/Typography.axaml"/>
                <ResourceInclude Source="avares://StreamAssist/Styles/Resources/Spacing.axaml"/>
                <ResourceInclude Source="avares://StreamAssist/Components/AppAction/UI/Configurator/ConfiguratorTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- shared styles (order matters: when two styles set the same property, the later one wins) -->

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/TextBlock.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/TextBox.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/ComboBox.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/GridSplitter.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/Border.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/Button.axaml"/>
        <StyleInclude Source="avares://StreamAssist/Styles/Controls/TabStrip.axaml"/>
    </Application.Styles>

</Application>
