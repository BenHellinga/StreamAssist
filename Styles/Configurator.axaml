<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:configurator="using:StreamAssist.Components.Core.Configurator">

    <configurator:ConfiguratorTemplateSelector x:Key="ConfiguratorTemplateSelector"/>

    <DataTemplate x:Key="TextConfigurator" x:DataType="configurator:ConfigurableParameterViewModel">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Value}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NumberConfigurator" x:DataType="configurator:ConfigurableParameterViewModel">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding Value}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BoolConfigurator" x:DataType="configurator:ConfigurableParameterViewModel">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding Value}" HorizontalAlignment="Left"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FilepathConfigurator" x:DataType="configurator:ConfigurableParameterViewModel">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="No file selected…" IsReadOnly="True"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>