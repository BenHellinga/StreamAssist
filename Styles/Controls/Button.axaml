<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:StreamAssist.Styles">

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="CornerRadius" Value="{s:Gap Corners}"/>
        <Setter Property="BorderThickness" Value="{s:Gap BorderAll}"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- hover -->

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- a small tab in a panel's tab bar (e.g. Test / New reward), Open = its panel is showing, looks like a selected tab -->

    <Style Selector="Button.Tab.Open /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- an icon (Styles/Resources/Icons.axaml) takes the button's text colour, and the hover one like the text does
         (the hover colour is set on the button's template presenter, which a Path isn't inside of, hence its own rule) -->

    <Style Selector="Button Path.Icon">
        <Setter Property="Width" Value="{DynamicResource IconSize}"/>
        <Setter Property="Height" Value="{DynamicResource IconSize}"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <Style Selector="Button:pointerover Path.Icon">
        <Setter Property="Fill" Value="{DynamicResource TextBright}"/>
    </Style>
    <Style Selector="Button Path.Icon.Line">
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>
    <Style Selector="Button:pointerover Path.Icon.Line">
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- width always matches height -->

    <Style Selector="Button.Square">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Self}, Path=Bounds.Height}"/>
        <Setter Property="Padding" Value="0"/> <!-- the icon needs the whole square, a text button's side padding cut it off -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- sizes, combine with Square for icon buttons (e.g. Classes="Square Medium") -->

    <!-- corner buttons on keys and actions -->
    <Style Selector="Button.Small">
        <Setter Property="Height" Value="{DynamicResource SmallButtonSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>

    <!-- inline buttons next to inputs (config create/delete), as tall as the inputs -->
    <Style Selector="Button.Medium">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>

    <!-- standalone buttons (add/remove keyboard slot) -->
    <Style Selector="Button.Large">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <!-- square + size: explicit width, more reliable than the Bounds.Height binding above -->

    <Style Selector="Button.Square.Small">
        <Setter Property="Width" Value="{DynamicResource SmallButtonSize}"/>
    </Style>
    <Style Selector="Button.Square.Medium">
        <Setter Property="Width" Value="{DynamicResource ControlHeight}"/>
    </Style>
    <Style Selector="Button.Square.Large">
        <Setter Property="Width" Value="40"/>
    </Style>

</Styles>
