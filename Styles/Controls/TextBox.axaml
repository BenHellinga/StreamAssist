<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <!-- one line is ControlHeight tall (like a bind box); boxes that wrap or take Enter grow from there -->
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="8,3,6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- hover -->

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- focus -->

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- a ghost field: a box you type in to make a new thing (the empty row at the end of a list, "New table…"), barely
         there (ghost border and placeholder). Pointing at it or typing in it lights it up like any box -->
    <Style Selector="TextBox.New">
        <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}"/>
    </Style>
    <Style Selector="TextBox.New /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource GhostText}"/>
    </Style>

    <!-- plain: editable, but just the text on the background until it's being typed in (e.g. the Data tab's cells) -->
    <Style Selector="TextBox.Plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.Plain:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.Plain:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>

    <!-- the bottom editor's label box: its text coloured like the label on the key / bind box -->
    <Style Selector="TextBox.BindLabel">
        <Setter Property="Foreground" Value="{DynamicResource Bound}"/>
    </Style>

    <Style Selector="TextBox.BindLabel.Disabled">
        <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
    </Style>

</Styles>
