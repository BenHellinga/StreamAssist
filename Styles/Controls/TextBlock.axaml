<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
    </Style>

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
    </Style>

    <!-- marker class for field labels, no overrides yet -->
    <Style Selector="TextBlock.Label">
    </Style>

    <!-- a slot's label beside it (an if's "if" / "then" / "else"), level with the first line of what's in the slot -->
    <Style Selector="TextBlock.SlotLabel">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- :is so a SelectableTextBlock (text that can be copied, e.g. spotify's redirect uri) looks the same -->
    <Style Selector=":is(TextBlock).Description">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- a bind's label on its key / bind box: one line, green while enabled, red while disabled -->
    <Style Selector="TextBlock.BindLabel">
        <Setter Property="Foreground" Value="{DynamicResource Bound}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="TextBlock.BindLabel.Disabled">
        <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
    </Style>

    <Style Selector="TextBlock.Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style Selector="TextBlock.OutputLine">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- text the user can select and copy (looks like normal text) -->

    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="SelectableTextBlock.OutputLine">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</Styles>
