<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:StreamAssist.Styles">

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
    </Style>

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
    </Style>

    <!-- marker class for field labels, no overrides yet -->
    <Style Selector="TextBlock.Label">
    </Style>

    <!-- a label ending in a colon ("Name:"), so the gap after it is measured from the colon (ColonTrim) -->
    <Style Selector="TextBlock.Colon">
        <Setter Property="Margin" Value="{s:Gap ColonTrim}"/>
    </Style>

    <!-- a heading under a big title (e.g. Alerts / Redeems): the font's empty space above and below its letters is
         pulled back, so the text itself is the stack's 10 from what's around it -->
    <Style Selector="TextBlock.Subheading">
        <Setter Property="Margin" Value="0,-4,0,-4"/>
    </Style>

    <!-- a slot's label beside it (an if's "if" / "then" / "else"), level with the first line of what's in the slot -->
    <Style Selector="TextBlock.SlotLabel">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="{s:Gap SlotLabelTextMargin}"/>
    </Style>

    <!-- :is so a SelectableTextBlock (text that can be copied, e.g. spotify's redirect uri) looks the same -->
    <Style Selector=":is(TextBlock).Description">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- a bind's label on its key / bind box: one line, green while enabled, red while disabled -->
    <Style Selector="TextBlock.BindLabel">
        <Setter Property="Foreground" Value="{DynamicResource Bound}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style Selector="TextBlock.BindLabel.Disabled">
        <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
    </Style>

    <!-- text inside a box (a bind box's name and label line): the size of a text box's text -->
    <Style Selector="TextBlock.BoxText">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>

    <Style Selector="TextBlock.Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style Selector="TextBlock.OutputLine">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- text the user can select and copy (looks like normal text) -->

    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="SelectableTextBlock.OutputLine">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</Styles>
