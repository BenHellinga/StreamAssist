<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- hover -->

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- focus -->

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- a plain dropdown: just its text and its arrow (e.g. the Data tab's column types) -->
    <Style Selector="ComboBox.Plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.Plain:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox.Plain:focus /template/ Border#Background">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>

</Styles>
