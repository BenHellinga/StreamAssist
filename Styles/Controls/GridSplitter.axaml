<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Splitter}"/>
    </Style>

    <Style Selector="GridSplitter.ColumnSplitter">
        <Setter Property="Cursor" Value="SizeWestEast"/>
        <Setter Property="MinWidth" Value="5"/>
    </Style>

    <Style Selector="GridSplitter.RowSplitter">
        <Setter Property="Cursor" Value="SizeNorthSouth"/>
        <Setter Property="MinHeight" Value="5"/>
    </Style>

</Styles>
