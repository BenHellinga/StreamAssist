<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:StreamAssist.Styles">

    <!-- panel look (opt-in with Classes="Panel" so borders inside built-in controls are left alone) -->

    <Style Selector="Border.Panel">
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.07"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.07"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- thin lines: a divider across a region (ThinLineThickness tall, LineGap clear above and below, edge to edge of
         its region, which already keeps LineGap from any splitter), and a vertical one inside a region -->

    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="{DynamicResource ThinLineThickness}"/>
        <Setter Property="Margin" Value="{s:Gap HorizontalLineZone}"/>
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <Style Selector="Border.VerticalDivider">
        <Setter Property="Width" Value="{DynamicResource ThinLineThickness}"/>
        <Setter Property="Margin" Value="{s:Gap VerticalLineZone}"/>
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- drag source -->

    <Style Selector="Border.Draggable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.Draggable:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="Border.Draggable:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- drop target (the Dragover class is toggled by DropBehaviorHandler) -->

    <Style Selector="Border.Droppable.Dragover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bound}"/>
    </Style>
    <Style Selector="Border.Droppable.Dragover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- a list item that also takes drops (they go in before it): a line above it lights up. The item reaches 3px up into
         the 5px gap above it and pads its content 3px back down, so the blocks don't move and the 2px line sits in the
         middle of the gap rather than on top of the block -->

    <Style Selector="Border.InsertBefore">
        <Setter Property="Margin" Value="0,-3,0,0"/>
        <Setter Property="Padding" Value="0,2,0,0"/> <!-- + the 1px line = the 3px it reaches up, so the gap stays 5 and the line is its middle pixel -->
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="DragDrop.AllowDrop" Value="True"/>
    </Style>
    <!-- the line of a list's first item sits above the list, outside it and outside whatever holds the list (a slot list,
         a block, a view): lists, the part that draws their items, and views don't clip, so it shows. Scroll areas still
         clip (their own presenter), and anything that must clip says so itself (ClipToBounds="True") -->
    <Style Selector=":is(ItemsControl)">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector=":is(ItemsControl) /template/ ItemsPresenter">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector=":is(UserControl)">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector="Border.InsertBefore.Dragover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bound}"/>
    </Style>

    <!-- clickable -->

    <Style Selector="Border.Clickable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.Clickable:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="Border.Clickable:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <!-- state -->

    <Style Selector="Border.Bound">
        <Setter Property="BorderBrush" Value="{DynamicResource Bound}"/>
    </Style>

    <Style Selector="Border.Disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource Disabled}"/>
    </Style>

    <Style Selector="Border.Triggered">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- a bind's label keeps its green / red while its key or bind box is hovered or dragged over (the rules above
         brighten every other text in it; this comes after them so it wins) -->

    <Style Selector="Border.Clickable:pointerover TextBlock.BindLabel, Border.Draggable:pointerover TextBlock.BindLabel, Border.Droppable.Dragover TextBlock.BindLabel">
        <Setter Property="Foreground" Value="{DynamicResource Bound}"/>
    </Style>

    <Style Selector="Border.Clickable:pointerover TextBlock.BindLabel.Disabled, Border.Draggable:pointerover TextBlock.BindLabel.Disabled, Border.Droppable.Dragover TextBlock.BindLabel.Disabled">
        <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
    </Style>

</Styles>
