<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- palette: every raw color lives here, named by what it's for; the brushes below are what views use. These are the
         defaults: the Themes tab changes them live (Styles/ThemePalette.cs lists which brushes each color paints, its
         changes are saved in Config/theme.json and applied over these at startup).
         A calm, low contrast palette on black, with outlines only (no fills, see panel below).

         Kept for going back:
           the previous palette   White #ffffff, Gray200 #cccccc, Gray500 #888888, Gray700 #555555, Gray800 #333333,
                                  Gray900 #262626, Gray950 #1e1e1e, Purple #7c3aed, Green #22c55e, Red #ef4444
           the previous fills     PanelFill = Gray950, PanelFillHover = Gray900, PanelFillToggle = Gray900 -->

    <Color x:Key="ColorBackground">#000000</Color>
    <Color x:Key="ColorBright">#d6d6d6</Color>
    <Color x:Key="ColorText">#a6a6a6</Color>
    <Color x:Key="ColorMuted">#707070</Color>
    <Color x:Key="ColorDim">#4a4a4a</Color>
    <Color x:Key="ColorLine">#2e2e2e</Color>
    <Color x:Key="ColorGhost">#383838</Color>
    <Color x:Key="ColorSelected">#6b4fbb</Color>
    <Color x:Key="ColorEnabled">#3d9963</Color>
    <Color x:Key="ColorDisabled">#b3504f</Color>

    <!-- backgrounds -->

    <SolidColorBrush x:Key="MainBackground" Color="{StaticResource ColorBackground}"/>

    <!-- text -->

    <SolidColorBrush x:Key="TextBright" Color="{StaticResource ColorBright}"/>
    <SolidColorBrush x:Key="TextNormal" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource ColorMuted}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource ColorDim}"/>

    <!-- accent -->

    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorSelected}"/>

    <!-- panel -->

    <!-- outlines only: no fills on boxes, blocks, keys, buttons, dropdowns (the previous fills are in the palette's note).
         Black at the lowest opacity rather than Transparent: it looks the same on any background, but a fully
         transparent fill isn't something the pointer can land on, so clicks and drops would only work on a box's text -->
    <SolidColorBrush x:Key="PanelFill" Color="#01000000"/>
    <SolidColorBrush x:Key="PanelFillHover" Color="#01000000"/>
    <SolidColorBrush x:Key="PanelFillToggle" Color="#01000000"/>

    <SolidColorBrush x:Key="PanelBorder" Color="{StaticResource ColorLine}"/>
    <SolidColorBrush x:Key="PanelBorderHover" Color="{StaticResource ColorSelected}"/>
    <SolidColorBrush x:Key="PanelBorderToggle" Color="{StaticResource ColorSelected}"/>

    <!-- borders -->

    <SolidColorBrush x:Key="Border" Color="{StaticResource ColorLine}"/>
    <!-- ghost fields: their border and their text (placeholder, the + in empty slots) -->
    <SolidColorBrush x:Key="Ghost" Color="{StaticResource ColorGhost}"/>
    <SolidColorBrush x:Key="Splitter" Color="{StaticResource ColorLine}"/>

    <!-- actions -->

    <SolidColorBrush x:Key="Bound" Color="{StaticResource ColorEnabled}"/>
    <SolidColorBrush x:Key="Disabled" Color="{StaticResource ColorDisabled}"/>

</ResourceDictionary>
