<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- the base spacing values: everything else is worked out from these (Styles/Gap.cs: SpacingRecipes, used in views as
         Margin="{s:Gap ScrollInset}"). Views use these directly as Spacing="{DynamicResource SmallVerticalGap}" so they
         follow live; the Themes tab edits them (its changes are saved in Config/theme.json and applied over these at
         startup).

         lines and regions (the lines' widths are in Sizes.axaml):
           LineGap             5   the empty zone every line keeps on each side (the window's edge counts as a line).
                                   Lines bring it themselves (their styles): nothing else goes in it, not content and not
                                   other lines, so a divider stops LineGap short of a splitter
           ContentGap         10   a line to content: regions pad by ContentGap - LineGap (the ContentPadding recipe)
                                   inside the lines' zones

         content to content (set on the container: StackPanel Spacing, Grid Column/RowSpacing, by the direction it stacks):
           Small / Medium / Large Horizontal / Vertical Gap   5 / 10 / 15: a button to the next, a label to its box, rows
                                   of a list: Small; around a subheading: Medium; around a big title: Large

         small fixed ones inside controls:
           CornerGap           2   a box's corner buttons from its edge and from each other
           BoxTextInset        6   text inside a bind box from its left edge -->



    <x:Double x:Key="LineGap">5</x:Double>
    <x:Double x:Key="ContentGap">10</x:Double>

    <x:Double x:Key="SmallHorizontalGap">5</x:Double>
    <x:Double x:Key="MediumHorizontalGap">10</x:Double>
    <x:Double x:Key="LargeHorizontalGap">15</x:Double>
    <x:Double x:Key="SmallVerticalGap">5</x:Double>
    <x:Double x:Key="MediumVerticalGap">10</x:Double>
    <x:Double x:Key="LargeVerticalGap">15</x:Double>

    <x:Double x:Key="CornerGap">2</x:Double>
    <x:Double x:Key="BoxTextInset">6</x:Double>



    <!-- layout sizes (not in the Themes tab) -->

    <!-- extra room below a tab's scrolled content, so the last row can be scrolled up to a comfortable spot
         (Padding on a Border wrapping the content of each tab's main scroll area and the bottom editor;
         a ScrollViewer's own Padding doesn't add scroll room) -->
    <Thickness x:Key="ScrollEndPadding">0,0,0,200</Thickness>

    <!-- the label column beside slots (an if's "else if" / "then" / "else"), fixed so every row's slot lines up -->
    <x:Double x:Key="SlotLabelWidth">70</x:Double>

</ResourceDictionary>
