<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- small icons drawn as shapes (the mono font has no media symbols, and Windows would swap in colour emoji), 10px
         tall, shown with <Path Classes="Icon" Data="{StaticResource PlayIcon}"/> inside a Square button. Filled ones,
         except the X (Classes="Icon Line", drawn as lines) -->

    <StreamGeometry x:Key="PlayIcon">M1,0 L9,5 L1,10 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIcon">M1,0 H4 V10 H1 Z M6,0 H9 V10 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="SkipIcon">M0,0 L6,5 L0,10 Z M7,0 H9 V10 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="StopIcon">M1,1 H9 V9 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="CrossIcon">M1,1 L9,9 M9,1 L1,9</StreamGeometry>

</ResourceDictionary>
