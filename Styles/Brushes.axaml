<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- backgrounds -->

    <SolidColorBrush x:Key="MainBackground" Color="#000000"/>

    <!-- text -->

    <SolidColorBrush x:Key="TextBright" Color="#ffffff"/>
    <SolidColorBrush x:Key="TextNormal" Color="#cccccc"/>
    <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
    <SolidColorBrush x:Key="TextDim" Color="#555555"/>

    <!-- panel -->

    <SolidColorBrush x:Key="PanelFill" Color="#1e1e1e"/>
    <SolidColorBrush x:Key="PanelFillHover" Color="#262626"/>
    <SolidColorBrush x:Key="PanelFillToggle" Color="#262626"/>

    <SolidColorBrush x:Key="PanelBorder" Color="#333333"/>
    <SolidColorBrush x:Key="PanelBorderHover" Color="#7c3aed"/>
    <SolidColorBrush x:Key="PanelBorderToggle" Color="#7c3aed"/>

    <!-- borders -->

    <SolidColorBrush x:Key="Border" Color="#333333"/>
    <SolidColorBrush x:Key="Splitter" Color="#333333"/>

    <!-- actions -->

    <SolidColorBrush x:Key="BoundAction" Color="#22c55e"/>

</ResourceDictionary>