<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg" Color="#0f0f0f"/>
    <SolidColorBrush x:Key="ConsoleBg" Color="#141414"/>
    <SolidColorBrush x:Key="PanelBg" Color="#1e1e1e"/>
    <SolidColorBrush x:Key="PanelBgHover" Color="#262626"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#2a2a2a"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#3a3a3a"/>
    <SolidColorBrush x:Key="Border" Color="#333333"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#444444"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#cccccc"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
    <SolidColorBrush x:Key="TextMuted" Color="#555555"/>
    <SolidColorBrush x:Key="TextBright" Color="#ffffff"/>

    <SolidColorBrush x:Key="Accent" Color="#7c3aed"/>
    <SolidColorBrush x:Key="AccentLight" Color="#a78bfa"/>
    <SolidColorBrush x:Key="Success" Color="#22c55e"/>
    <SolidColorBrush x:Key="DragoverBg" Color="#2a3a2a"/>

</ResourceDictionary>