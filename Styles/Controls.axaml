<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         Base — every TextBlock/Button/ComboBox/TextBox gets the mono
         font and sane default colors automatically.
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonBgHover}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Text roles
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBlock.header">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.line">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- title/description, sized via an extra "small"/"large" class,
         e.g. Classes="title small" — used by ActionList + ActionPanel -->
    <Style Selector="TextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.title.small">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.title.large">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.description">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.description.small">
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.description.large">
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Layout helpers
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Cards
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="Border.action-card">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.action-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelBgHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Add / remove circular buttons
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.add-remove">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.add-remove:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Keyboard keys
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.key">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.07"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.07"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.key.pressed">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
    </Style>
    <Style Selector="Border.key TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.key.pressed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>
    <Style Selector="Border.key.bound">
        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.key.dragover">
        <Setter Property="Background" Value="{DynamicResource DragoverBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
    </Style>

</Styles>