<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:dragging="using:StreamAssist.Components.Core.Dragging">



    <!-- textblock -->



    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style Selector="TextBlock.Label">
    </Style>

    <Style Selector="TextBlock.Description">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <Style Selector="TextBlock.OutputLine">
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>



    <!-- textbox -->



    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



    <!-- combo box -->



    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



    <!-- gridsplitter -->



    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Splitter}"/>
    </Style>

    <Style Selector="GridSplitter.ColumnSplitter">
        <Setter Property="Cursor" Value="SizeWestEast"/>
        <Setter Property="MinWidth" Value="5"/>
    </Style>

    <Style Selector="GridSplitter.RowSplitter">
        <Setter Property="Cursor" Value="SizeNorthSouth"/>
        <Setter Property="MinHeight" Value="5"/>
    </Style>



    <!-- border -->



    <Style Selector="Border">
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.07"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.07"/>
            </Transitions>
        </Setter>
    </Style>



    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>



    <Style Selector="Border.Draggable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.Draggable:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="Border.Draggable:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



    <Style Selector="Border.Droppable">
    </Style>
    <Style Selector="Border.Droppable.Dragover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BoundAction}"/>
    </Style>
    <Style Selector="Border.Droppable.Dragover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



    <Style Selector="Border.Clickable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.Clickable:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>
    <Style Selector="Border.Clickable:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



    <Style Selector="Border.Bound">
        <Setter Property="BorderBrush" Value="{DynamicResource BoundAction}"/>
    </Style>



    <Style Selector="Border.Triggered">
        <Setter Property="Background" Value="{DynamicResource PanelBorderHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
    </Style>



    <!-- button -->



    <Style Selector="Button">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <Style Selector="Button.Square">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Self}, Path=Bounds.Height}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>



    <!-- tab strip -->



    <Style Selector="ListBox.TopTabStrip">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Background" Value="{DynamicResource MainBackground}"/>

        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5"/>
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="ListBox.TopTabStrip ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource PanelFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextNormal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="DragDrop.AllowDrop" Value="True"/>
        <Setter Property="dragging:DragHoverTabSwitch.Enable" Value="True"/>
    </Style>

    <Style Selector="ListBox.TopTabStrip ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelFillHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>

    <Style Selector="ListBox.TopTabStrip ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelFillToggle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderToggle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
    </Style>



</Styles>
