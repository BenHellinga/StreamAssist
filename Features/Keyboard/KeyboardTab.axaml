<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Features.Keyboard"
             xmlns:local="using:StreamAssist.Features.Keyboard"
             x:Class="StreamAssist.Features.Keyboard.KeyboardTab"
             x:DataType="vm:KeyboardTabViewModel">

    <DockPanel Margin="16">

        <local:TopMenu DockPanel.Dock="Top"
                       Margin="0,0,0,14"
                       DataContext="{Binding TopMenu}"/>

        <!-- ActionList width is fixed here (260) — bump it if your action -->
        <!-- names/descriptions need more room.                            -->
        <Grid ColumnDefinitions="*,16,260">
            <local:KeyboardDisplay Grid.Column="0" DataContext="{Binding KeyboardDisplay}"/>
            <local:ActionList Grid.Column="2" DataContext="{Binding ActionList}"/>
        </Grid>

    </DockPanel>

</UserControl>
