<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Features.Keyboard"
             xmlns:local="using:StreamAssist.Features.Keyboard"
             x:Class="StreamAssist.Features.Keyboard.KeyboardTab"
             x:DataType="vm:KeyboardTabViewModel">

    <DockPanel Margin="16">

        <!-- ActionList width and ActionPanel height are resizable via    -->
        <!-- GridSplitter — dragging updates the bound GridLength         -->
        <!-- directly (two-way bound), so the resize sticks for the rest  -->
        <!-- of the session, same as MainWindow's console splitter.       -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="{Binding ActionListWidth, Mode=TwoWay}" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- KeyboardList (all keyboards + +/-) on top, ActionPanel    -->
            <!-- below, resizable splitter between them.                  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="{Binding ActionPanelHeight, Mode=TwoWay}" MinHeight="70"/>
                </Grid.RowDefinitions>

                <local:KeyboardList Grid.Row="0" DataContext="{Binding KeyboardList}"/>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              Margin="0,7"
                              Background="#333333"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Cursor="SizeNorthSouth"/>

                <local:ActionPanel Grid.Row="2" DataContext="{Binding ActionPanel}"/>
            </Grid>

            <GridSplitter Grid.Column="1"
                           Width="6"
                           Margin="10,0"
                           Background="#333333"
                           HorizontalAlignment="Stretch"
                           Cursor="SizeWestEast"/>

            <local:ActionList Grid.Column="2" DataContext="{Binding ActionList}"/>
        </Grid>

    </DockPanel>

</UserControl>