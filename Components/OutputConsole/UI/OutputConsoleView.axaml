<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.OutputConsole.UI.OutputConsoleView"
             x:DataType="ui:OutputConsoleViewModel"

             xmlns:ui="using:StreamAssist.Components.OutputConsole.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- console panel -->

    <DockPanel>

        <!-- header -->

        <!-- title, Clear beside it (as on a console dock) -->

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"
                    Margin="{s:Gap PadAll}" Height="{DynamicResource ControlHeight}">

            <TextBlock Classes="Label" Text="Output" VerticalAlignment="Center"/>

            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    Height="{DynamicResource ControlHeight}"
                    VerticalContentAlignment="Center"/>

        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="Divider"/>

        <!-- log messages (selectable, [time]s muted, scrolls to new lines) -->

        <ui:LogView Text="{Binding Text}"/>

    </DockPanel>
</UserControl>
