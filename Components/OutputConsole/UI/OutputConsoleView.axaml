<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.OutputConsole.UI.OutputConsoleView"
             x:DataType="ui:OutputConsoleViewModel"

             xmlns:ui="using:StreamAssist.Components.OutputConsole.UI">

    <!-- console panel -->

    <DockPanel>

        <!-- header -->

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{StaticResource HeaderMargin}">

            <TextBlock Grid.Column="0"
                       Classes="Label"
                       Text="Output"/>

            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    VerticalAlignment="Center"/>

        </Grid>

        <Border DockPanel.Dock="Top" Classes="Divider" Margin="{StaticResource DividerMargin}"/>

        <!-- log messages -->

        <ScrollViewer x:Name="LogScrollViewer" Margin="5">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="OutputLine" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
