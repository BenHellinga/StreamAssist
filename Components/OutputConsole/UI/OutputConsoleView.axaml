<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.OutputConsole.UI.OutputConsoleView"
             x:DataType="ui:OutputConsoleViewModel"

             xmlns:ui="using:StreamAssist.Components.OutputConsole.UI">

    <!-- console panel -->

    <DockPanel>

        <!-- header -->

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{StaticResource HeaderMargin}">

            <TextBlock Grid.Column="0"
                       Classes="Label"
                       Text="Output"/>

            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    VerticalAlignment="Center"/>

        </Grid>

        <Border DockPanel.Dock="Top" Classes="Divider" Margin="{StaticResource DividerMargin}"/>

        <!-- log messages -->

        <!-- one selectable text for the whole log: drag to select across lines, Ctrl+A / Ctrl+C or right click to copy -->

        <ScrollViewer x:Name="LogScrollViewer" Margin="5">
            <!-- fills the whole console (transparent background) so clicking empty space still focuses it for Ctrl+A -->
            <SelectableTextBlock Classes="OutputLine" Text="{Binding Text}" Background="Transparent"
                                 MinHeight="{Binding #LogScrollViewer.Bounds.Height}"/>
        </ScrollViewer>

    </DockPanel>
</UserControl>
