<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.OutputConsole.UI.OutputConsoleView"
             x:DataType="ui:OutputConsoleViewModel"

             xmlns:ui="using:StreamAssist.Components.OutputConsole.UI">

    <!-- console panel -->

    <DockPanel>

        <!-- header -->

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{StaticResource HeaderMargin}" Height="{StaticResource HeaderHeight}">

            <TextBlock Grid.Column="0"
                       Classes="Label"
                       Text="Output"/>

            <!-- as tall as the tab strip's tabs (the whole header row) -->

            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    Height="{StaticResource HeaderHeight}"
                    VerticalContentAlignment="Center"/>

        </Grid>

        <Border DockPanel.Dock="Top" Classes="Divider" Margin="{StaticResource DividerMargin}"/>

        <!-- log messages -->

        <!-- one selectable text for the whole log: drag to select across lines, Ctrl+A / Ctrl+C or right click to copy
             its text is built in code-behind from the view model's Text, so each line's [time] can be muted -->

        <ScrollViewer x:Name="LogScrollViewer" Classes="Gapped">
            <!-- fills the whole console (transparent background) so clicking empty space still focuses it for Ctrl+A
                 (inset with Padding, not Margin, so filling the console doesn't make it scrollable) -->
            <SelectableTextBlock x:Name="LogText" Classes="OutputLine" Background="Transparent" Padding="5"
                                 MinHeight="{Binding #LogScrollViewer.Bounds.Height}"/>
        </ScrollViewer>

    </DockPanel>
</UserControl>
