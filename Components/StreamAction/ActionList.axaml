<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:action="using:StreamAssist.Components.StreamAction"
             x:Class="StreamAssist.Components.StreamAction.ActionList"
             x:DataType="action:ActionListViewModel">

    <DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Classes="header"
                   Text="Actions"
                   Margin="0,0,0,8"/>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="action:IStreamAction">
                        <Border Classes="action-card"
                                Tag="{Binding}"
                                PointerPressed="OnActionPointerPressed">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title small" Text="{Binding Name}"/>
                                <TextBlock Classes="description small"
                                           Text="{Binding Description}"
                                           MaxLines="2"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>