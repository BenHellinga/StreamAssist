<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Components.StreamAction"
             x:Class="StreamAssist.Components.StreamAction.ActionPanel"
             x:DataType="vm:ActionPanelViewModel">

    <Border Classes="card" Padding="12,10" VerticalAlignment="Stretch">
        <Grid>
            <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="title large" Text="{Binding ActionName}"/>
                <TextBlock Classes="description large" Text="{Binding ActionDescription}"/>
            </StackPanel>

            <TextBlock Classes="placeholder"
                       Text="Click a bound key to see its action here."
                       IsVisible="{Binding !HasSelection}"/>
        </Grid>
    </Border>

</UserControl>