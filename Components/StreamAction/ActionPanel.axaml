<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.StreamAction.ActionPanel"
             x:DataType="action:ActionPanelViewModel"

             xmlns:action="using:StreamAssist.Components.StreamAction">

    <!-- action panel -->

    <Border VerticalAlignment="Stretch">
        <Grid Margin="5">

            <!-- action info/data -->

            <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="Label" Text="{Binding ActionName}"/>
                <TextBlock Classes="Description" Text="{Binding ActionDescription}"/>
            </StackPanel>

            <TextBlock Classes="Placeholder"
                       VerticalAlignment="Top"
                       Text="Click a bound key to see its action here."
                       IsVisible="{Binding !HasSelection}"/>

        </Grid>
    </Border>

</UserControl>