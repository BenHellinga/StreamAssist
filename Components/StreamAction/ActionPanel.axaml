<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Components.StreamAction"
             x:Class="StreamAssist.Components.StreamAction.ActionPanel"
             x:DataType="vm:ActionPanelViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBlock.action-panel-name">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        </Style>
        <Style Selector="TextBlock.action-panel-desc">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
        </Style>
    </UserControl.Styles>

    <!-- Always present in the layout; just shows a placeholder until a -->
    <!-- bound key is clicked on the KeyboardDisplay above.             -->
    <Border Classes="panel" VerticalAlignment="Stretch">
        <Grid>
            <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="action-panel-name" Text="{Binding ActionName}"/>
                <TextBlock Classes="action-panel-desc" Text="{Binding ActionDescription}"/>
            </StackPanel>

            <TextBlock Classes="placeholder"
                       Text="Click a bound key to see its action here."
                       IsVisible="{Binding !HasSelection}"/>
        </Grid>
    </Border>

</UserControl>