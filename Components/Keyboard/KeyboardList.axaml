<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Components.Keyboard"
             xmlns:local="using:StreamAssist.Components.Keyboard"
             x:Class="StreamAssist.Components.Keyboard.KeyboardList"
             x:DataType="vm:KeyboardListViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,0,0,100">

            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyboardSlotViewModel">
                        <StackPanel Spacing="20">
                            <local:KeyboardSlot DataContext="{Binding}"/>
                            <Border Classes="divider"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <Button Classes="add-remove"
                        Content="+"
                        Command="{Binding AddKeyboardCommand}"
                        ToolTip.Tip="Add another keyboard"/>
                <Button Classes="add-remove"
                        Content="－"
                        Command="{Binding RemoveKeyboardCommand}"
                        ToolTip.Tip="Remove the last keyboard"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>