<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardTab"
             x:DataType="keyboard:KeyboardTabViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"
             xmlns:action="using:StreamAssist.Components.StreamAction">

    <!-- keyboard tab -->

    <DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="200" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- keybind column -->

            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="200" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- keyboard list -->

                <keyboard:KeyboardList Grid.Row="0"
                                       DataContext="{Binding KeyboardList}"
                                       Margin="0,0,0,5"/>

                <GridSplitter Grid.Row="1" Classes="RowSplitter" Margin="0,0,0,5"/>

                <!-- action panel -->

                <action:ActionPanel Grid.Row="2" DataContext="{Binding ActionPanel}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="ColumnSplitter" Margin="0,0,5,0"/>

            <!-- action list -->

            <action:ActionList Grid.Column="2" DataContext="{Binding ActionList}"/>
        </Grid>

    </DockPanel>

</UserControl>