<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardSlotView"
             x:DataType="keyboard:KeyboardSlotViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- a bound key's edit buttons show only while the pointer is on it (hidden by opacity, so nothing moves). Here once
         for every key of the slot, rather than in each KeyView -->

    <UserControl.Styles>
        <Style Selector="keyboard|KeyView blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="keyboard|KeyView Border.Bound:pointerover blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- the box's own corner buttons: hidden the same way, shown while the pointer is on the box (its own only, not
             the keys') -->
        <Style Selector="blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border#Card:pointerover > Panel > blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <!-- an input device box, like a block: a green outline (red while off), a LineGap ring inside it. The device dropdown
         as its header, a divider at the ring, then the keys ContentGap from the border (hidden while collapsed). The
         corner buttons (collapse, on / off, drag, remove) show on hover, CornerGap from the border, out of the ring -->

    <Border x:Name="Card" Classes="Panel Bound" Classes.Disabled="{Binding IsDisabled}" Padding="{s:Gap LineZoneAll}">
        <Panel>
            <DockPanel>

                <ComboBox DockPanel.Dock="Top" Margin="{s:Gap PadAll}" HorizontalAlignment="Left"
                          ItemsSource="{Binding DeviceMenuItems}"
                          SelectedItem="{Binding MenuDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="keyboard:DeviceMenuItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border DockPanel.Dock="Top" Classes="Divider" IsVisible="{Binding !IsCollapsed}"/>

                <!-- keyboard (each KeyViewModel becomes a KeyView through the ViewLocator), as wide as the box -->

                <Decorator x:Name="KeyboardHost" Margin="{s:Gap PadAll}" IsVisible="{Binding !IsCollapsed}">
                    <ItemsControl ItemsSource="{Binding Keys}"
                                  Width="{Binding CurrentWidth}"
                                  Height="{Binding CurrentHeight}">

                        <!-- canvas -->

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- position each key -->

                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter"
                                          x:DataType="keyboard:KeyViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>

                    </ItemsControl>
                </Decorator>

            </DockPanel>

            <blocks:EditButtons Classes="HoverOnly" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{s:Gap RingCornerMargin}"/>
        </Panel>
    </Border>

</UserControl>
