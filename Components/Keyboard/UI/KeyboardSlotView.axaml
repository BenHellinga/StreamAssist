<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardSlotView"
             x:DataType="keyboard:KeyboardSlotViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI">

    <!-- keyboard slot -->

    <StackPanel Spacing="10">

        <!-- menu -->

        <StackPanel Orientation="Horizontal" Spacing="20">

            <!-- config related -->

            <StackPanel Orientation="Horizontal" Spacing="10">

                <TextBlock Classes="Label" Text="Config"/>

                <!-- configs dropdown -->

                <ComboBox ItemsSource="{Binding ConfigMenuItems}"
                          SelectedItem="{Binding MenuConfig}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="keyboard:ConfigMenuItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- add config button -->

                <Button Classes="Square Medium"
                        Content="＋"
                        Command="{Binding CreateConfigPressedCommand}"
                        ToolTip.Tip="Create a copy of the current config with the name below"/>

                <!-- input config box -->

                <TextBox Text="{Binding InputConfig}"
                         PlaceholderText="Config name…"
                         Width="150"/>

                <!-- delete config button -->

                <Button Classes="Square Medium"
                        Content="－"
                        Command="{Binding DeleteConfigPressedCommand}"
                        ToolTip.Tip="Delete the selected config"/>

            </StackPanel>

            <!-- device related -->

            <StackPanel Orientation="Horizontal" Spacing="10">

                <TextBlock Classes="Label" Text="Device"/>

                <!-- device dropdown -->

                <ComboBox ItemsSource="{Binding DeviceMenuItems}"
                          SelectedItem="{Binding MenuDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="keyboard:DeviceMenuItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </StackPanel>
        </StackPanel>

        <!-- keyboard (each KeyViewModel becomes a KeyView through the ViewLocator) -->

        <Decorator x:Name="KeyboardHost">
            <ItemsControl ItemsSource="{Binding Keys}"
                          Width="{Binding CurrentWidth}"
                          Height="{Binding CurrentHeight}">

                <!-- canvas -->

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- position each key -->

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter"
                                  x:DataType="keyboard:KeyViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

            </ItemsControl>
        </Decorator>

    </StackPanel>
</UserControl>
