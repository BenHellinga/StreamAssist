<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardSlotView"
             x:DataType="keyboard:KeyboardSlotViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI">

    <!-- a bound key's edit buttons show only while the pointer is on it (hidden by opacity, so nothing moves). Here once
         for every key of the slot, rather than in each KeyView -->

    <UserControl.Styles>
        <Style Selector="keyboard|KeyView blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="keyboard|KeyView Border.Bound:pointerover blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <!-- keyboard slot -->

    <StackPanel Spacing="10">

        <!-- menu -->

        <StackPanel Orientation="Horizontal" Spacing="20">

            <!-- device related -->

            <StackPanel Orientation="Horizontal" Spacing="10">

                <TextBlock Classes="Label" Text="Device"/>

                <!-- device dropdown -->

                <ComboBox ItemsSource="{Binding DeviceMenuItems}"
                          SelectedItem="{Binding MenuDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="keyboard:DeviceMenuItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </StackPanel>

            <!-- layout: the keyboard picture, or every key code (F13-F24, media keys, ...) -->

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="Label" Text="Layout"/>
                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding MenuLayout}"
                          ToolTip.Tip="Binds belong to keys, so a bind shows in every layout that has its key"/>
            </StackPanel>
        </StackPanel>

        <!-- keyboard (each KeyViewModel becomes a KeyView through the ViewLocator) -->

        <Decorator x:Name="KeyboardHost">
            <ItemsControl ItemsSource="{Binding Keys}"
                          Width="{Binding CurrentWidth}"
                          Height="{Binding CurrentHeight}">

                <!-- canvas -->

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- position each key -->

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter"
                                  x:DataType="keyboard:KeyViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

            </ItemsControl>
        </Decorator>

    </StackPanel>
</UserControl>
