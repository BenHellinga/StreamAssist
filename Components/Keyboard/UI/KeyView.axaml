<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyView"
             x:DataType="keyboard:KeyViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"

             Width="{Binding W}"
             Height="{Binding H}">

    <!-- single key -->

    <Border Classes="Droppable"
            Classes.Triggered="{Binding IsPressed}"
            Classes.Bound="{Binding IsBound}"
            Classes.Disabled="{Binding !IsEnabled}"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="OnDragOver"
            DragDrop.DragLeave="OnDragLeave"
            DragDrop.Drop="OnDrop"
            PointerPressed="OnPointerPressed">

        <Grid>
            <TextBlock Text="{Binding Label}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Spacing="2" Margin="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        IsVisible="{Binding IsSelected}">

                <!-- drag handle -->

                <Border Classes="Draggable"
                        Width="16" Height="16"
                        PointerPressed="OnHandlePointerPressed">
                    <TextBlock Text="⠿" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- toggle disable -->

                <Button Classes="ToggleEnabled"
                        Width="16" Height="16"
                        Padding="0"
                        Command="{Binding ToggleEnabledPressedCommand}"
                        ToolTip.Tip="Enable/disable this binding">
                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Button>

                <!-- unbind -->

                <Button Classes="RemoveAction"
                        Width="16" Height="16"
                        Padding="0"
                        Command="{Binding UnbindPressedCommand}"
                        ToolTip.Tip="Unbind this key">
                    <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>