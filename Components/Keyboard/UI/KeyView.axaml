<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyView"
             x:DataType="keyboard:KeyViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI"

             Width="{Binding W}"
             Height="{Binding H}">

    <!-- the buttons only show while the pointer is on a key that has a binding (hidden by opacity, so nothing moves) -->

    <UserControl.Styles>
        <Style Selector="blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.Bound:pointerover > Grid > blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <!-- single key -->

    <Border Classes="Panel Droppable"
            Classes.Triggered="{Binding IsPressed}"
            Classes.Bound="{Binding IsBound}"
            Classes.Disabled="{Binding IsDisabled}"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="OnDragOver"
            DragDrop.DragLeave="OnDragLeave"
            DragDrop.Drop="OnDrop"
            PointerPressed="OnPointerPressed">

        <!-- the key's name, then the binding's label (if it has one) as one more line that ends in ... when too long,
             centred up and down as one block (so a label pushes the name up) -->

        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" TextAlignment="Center"/>
                <TextBlock Classes="BindLabel" Classes.Disabled="{Binding IsDisabled}"
                           Text="{Binding BindLabel}" IsVisible="{Binding BindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BindLabel}"/>
            </StackPanel>

            <blocks:EditButtons Classes="HoverOnly"/>
        </Grid>
    </Border>
</UserControl>
