<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyView"
             x:DataType="keyboard:KeyViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"
             xmlns:action="using:StreamAssist.Components.AppAction.UI"

             Width="{Binding W}"
             Height="{Binding H}">

    <!-- single key -->

    <Border Classes="Droppable"
            Classes.Triggered="{Binding IsPressed}"
            Classes.Bound="{Binding IsBound}"
            Classes.Disabled="{Binding IsDisabled}"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="OnDragOver"
            DragDrop.DragLeave="OnDragLeave"
            DragDrop.Drop="OnDrop"
            PointerPressed="OnPointerPressed">

        <Grid>
            <TextBlock Text="{Binding Label}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <action:ActionUIButtons IsVisible="{Binding IsSelected}"/>
        </Grid>
    </Border>
</UserControl>