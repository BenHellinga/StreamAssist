<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardListView"
             x:DataType="keyboard:KeyboardListViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI">

    <!-- the tab's config (every keyboard's keys switch with it), a divider, then the keyboard list -->

    <DockPanel>

        <ContentControl DockPanel.Dock="Top" Content="{Binding ConfigBar}" Margin="{StaticResource HeaderMargin}"/>
        <Border DockPanel.Dock="Top" Classes="Divider" Margin="{StaticResource DividerMargin}"/>

        <!-- no config: an empty page that says to make one -->
        <ContentControl Content="{Binding NoConfig}" IsVisible="{Binding !HasConfig}"/>

        <ScrollViewer IsVisible="{Binding HasConfig}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Classes="Gapped">

            <!-- stack of keyboard list and add/remove buttons -->

            <!-- the padding is room to scroll the last row up (Spacing.axaml ScrollEndPadding) -->
            <Border Padding="{StaticResource ScrollEndPadding}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{Binding Slots}">

                        <!-- stack of keyboard/divider pairs -->

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- stack of one keyboard/divider pair -->

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="keyboard:KeyboardSlotViewModel">
                                <StackPanel Spacing="9">

                                    <!-- keyboard slot -->

                                    <keyboard:KeyboardSlotView Margin="5,0"/>

                                    <Border Classes="Divider"/>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!-- horizontal stack of add/remove buttons -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="10">

                        <Button Classes="Square Large"
                                Content="＋"
                                Command="{Binding AddSlotRequestedCommand}"
                                ToolTip.Tip="Add another keyboard"/>

                        <Button Classes="Square Large"
                                Content="－"
                                Command="{Binding RemoveSlotRequestedCommand}"
                                ToolTip.Tip="Remove the last keyboard"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>
</UserControl>
