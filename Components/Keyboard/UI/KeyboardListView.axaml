<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyboardListView"
             x:DataType="keyboard:KeyboardListViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI">

    <!-- keyboard list -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Margin="0,5">

        <!-- stack of keyboard list and add/remove buttons -->

        <StackPanel Spacing="10" Margin="0,0,5,200">
            <ItemsControl ItemsSource="{Binding Slots}">

                <!-- stack of keyboard/divider pairs -->

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- stack of one keyboard/divider pair -->

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="keyboard:KeyboardSlotViewModel">
                        <StackPanel Spacing="9">

                            <!-- keyboard slot -->

                            <keyboard:KeyboardSlotView Margin="5,0"/>

                            <Border Classes="Divider"/>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- horizontal stack of add/remove buttons -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">

                <Button Classes="Square Large"
                        Content="＋"
                        Command="{Binding AddSlotRequestedCommand}"
                        ToolTip.Tip="Add another keyboard"/>

                <Button Classes="Square Large"
                        Content="－"
                        Command="{Binding RemoveSlotRequestedCommand}"
                        ToolTip.Tip="Remove the last keyboard"/>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
