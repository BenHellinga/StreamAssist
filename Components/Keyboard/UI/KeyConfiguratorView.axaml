<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Keyboard.UI.KeyConfiguratorView"
             x:DataType="keyboard:KeyConfiguratorViewModel"

             xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI">

    <!-- key configurator -->

    <TextBlock Text="{Binding StatusText}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

</UserControl>