<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StreamAssist.Components.Keyboard"
             x:Class="StreamAssist.Components.Keyboard.KeyboardSlot"
             x:DataType="vm:KeyboardSlotViewModel">

    <UserControl.Styles>
        <!-- toolbar styles -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3a"/>
        </Style>

        <!-- key styles -->
        <Style Selector="Border.key">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.07"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.07"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.key.pressed">
            <Setter Property="Background" Value="#7c3aed"/>
            <Setter Property="BorderBrush" Value="#a78bfa"/>
        </Style>
        <Style Selector="Border.key TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.key.pressed TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="Border.key.bound">
            <Setter Property="BorderBrush" Value="#22c55e"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.key.dragover">
            <Setter Property="Background" Value="#2a3a2a"/>
            <Setter Property="BorderBrush" Value="#22c55e"/>
        </Style>
    </UserControl.Styles>

    <!-- One keyboard: its own toolbar (config/device picker) above its own -->
    <!-- rendered canvas. Fully independent from any other KeyboardDisplay. -->
    <StackPanel Spacing="10">

        <!-- ── Top toolbar ─────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" Spacing="24">

            <!-- Config picker -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="Config"/>
                <ComboBox ItemsSource="{Binding AllConfigs}"
                          SelectedItem="{Binding MenuConfig}"
                          MinWidth="140"/>
                <Button Content="＋"
                        Command="{Binding CreateConfigCommand}"
                        ToolTip.Tip="Create a copy of the current config with the name below"/>
                <TextBox Text="{Binding InputConfig}"
                        PlaceholderText="Config name…"
                        Width="130"/>
                <Button Content="－"
                        Command="{Binding DeleteConfigCommand}"
                        ToolTip.Tip="Delete selected config (cannot delete Default or active config)"/>
            </StackPanel>

            <!-- Device picker -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="Device"/>
                <ComboBox ItemsSource="{Binding AllDevices}"
                          SelectedItem="{Binding MenuDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyboardInfo">
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontSize="11"
                                       FontFamily="Cascadia Code,Consolas,Monospace"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

        </StackPanel>

        <!-- ── Keyboard container ──────────────────────────────────── -->
        <!-- Resize by changing the Border's Width/Height/Margin/Alignment. -->
        <!-- The Viewbox scales the canvas contents to fit whatever         -->
        <!-- space the Border occupies. Wrapped in a ScrollViewer so the    -->
        <!-- Viewbox always has "infinite" height to measure against -      -->
        <!-- it auto-scales horizontally only, and scrolls vertically when  -->
        <!-- the parent row gets squeezed (e.g. ActionPanel dragged up).    -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Border x:Name="KeyboardContainer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">

                <Viewbox Stretch="Uniform"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top">

                    <Canvas Width="{Binding CanvasWidth}"
                            Height="{Binding CanvasHeight}">
                        <ItemsControl ItemsSource="{Binding Keys}"
                                    Width="{Binding CanvasWidth}"
                                    Height="{Binding CanvasHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter"
                                            x:DataType="vm:KeyInfo">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyInfo">
                                    <Border Classes="key"
                                            Classes.pressed="{Binding IsPressed}"
                                            Classes.bound="{Binding HasBoundAction}"
                                            Width="{Binding W}"
                                            Height="{Binding H}"
                                            DragDrop.AllowDrop="True"
                                            DragDrop.DragOver="OnKeyDragOver"
                                            DragDrop.DragLeave="OnKeyDragLeave"
                                            DragDrop.Drop="OnKeyDrop"
                                            PointerPressed="OnKeyPointerPressed">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Label}"/>
                                            <TextBlock Text="{Binding BoundActionName}"
                                                       IsVisible="{Binding HasBoundAction}"
                                                       FontSize="8"
                                                       Foreground="#22c55e"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>

                </Viewbox>
            </Border>
        </ScrollViewer>

    </StackPanel>

</UserControl>