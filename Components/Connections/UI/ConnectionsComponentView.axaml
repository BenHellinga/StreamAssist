<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Connections.UI.ConnectionsComponentView"
             x:DataType="ui:ConnectionsComponentViewModel"

             xmlns:ui="using:StreamAssist.Components.Connections.UI">

    <!-- one section per connection, each row is a ConnectionRowView through the ViewLocator
         each section's content is inset, the dividers between sections run edge to edge -->

    <ScrollViewer Classes="Gapped" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- the padding is room to scroll the last row up (Spacing.axaml ScrollEndPadding) -->
        <Border Padding="{StaticResource ScrollEndPadding}">
            <StackPanel Spacing="10">

                <!-- twitch: the app both accounts log in through (hidden, the eye button shows them, safe to have on stream) -->

                <StackPanel Spacing="10" Margin="{StaticResource ContentInset}">
                    <TextBlock Classes="Title" Text="Twitch"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="Label" Text="Client ID" Width="100"/>
                        <TextBox Text="{Binding ClientIdInput}" Width="260"
                                 PasswordChar="●" Classes="revealPasswordButton" PlaceholderText="From dev.twitch.tv"/>
                        <TextBlock Classes="Label" Text="Client Secret"/>
                        <TextBox Text="{Binding ClientSecretInput}" Width="260"
                                 PasswordChar="●" Classes="revealPasswordButton" PlaceholderText="From dev.twitch.tv"/>
                    </StackPanel>

                    <ContentControl Content="{Binding TwitchStreamer}"
                                    ToolTip.Tip="Listens to your chat, redeems, subs, raids, ... (the first time it shows a login link in the console)"/>
                    <ContentControl Content="{Binding TwitchBot}"
                                    ToolTip.Tip="Optional, only sends chat (log in through the console link while logged in to twitch as the bot). Without it, chat is sent as the streamer, unless Chat only as bot is ticked: then chat and moderation only ever go out as the bot, and fail while it isn't connected"/>
                </StackPanel>

                <Border Classes="Divider"/>

                <StackPanel Spacing="10" Margin="{StaticResource ContentInset}">
                    <TextBlock Classes="Title" Text="Voicemeeter"/>
                    <ContentControl Content="{Binding Voicemeeter}"/>
                </StackPanel>

                <Border Classes="Divider"/>

                <!-- obs: its websocket server (OBS: Tools > WebSocket Server Settings), password hidden like twitch's -->

                <StackPanel Spacing="10" Margin="{StaticResource ContentInset}">
                    <TextBlock Classes="Title" Text="OBS"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="Label" Text="Address" Width="100"/>
                        <TextBox Text="{Binding ObsAddressInput}" Width="260" PlaceholderText="localhost:4455"/>
                        <TextBlock Classes="Label" Text="Password"/>
                        <TextBox Text="{Binding ObsPasswordInput}" Width="260"
                                 PasswordChar="●" Classes="revealPasswordButton" PlaceholderText="From OBS"/>
                    </StackPanel>

                    <ContentControl Content="{Binding Obs}"
                                    ToolTip.Tip="Lets blocks switch scenes, show/hide and move sources, set volumes and text (turn on OBS's WebSocket server in Tools > WebSocket Server Settings)"/>
                </StackPanel>

                <Border Classes="Divider"/>

                <!-- spotify: your app on developer.spotify.com (hidden like twitch's), whose Redirect URI has to be the one shown -->

                <StackPanel Spacing="10" Margin="{StaticResource ContentInset}">
                    <TextBlock Classes="Title" Text="Spotify"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="Label" Text="Client ID" Width="100"/>
                        <TextBox Text="{Binding SpotifyClientIdInput}" Width="260"
                                 PasswordChar="●" Classes="revealPasswordButton" PlaceholderText="From developer.spotify.com"/>
                        <TextBlock Classes="Label" Text="Redirect URI"/>
                        <SelectableTextBlock Classes="Description" Text="{Binding SpotifyRedirectUri}" VerticalAlignment="Center"
                                             ToolTip.Tip="Add this exactly to your app on developer.spotify.com"/>
                    </StackPanel>

                    <ContentControl Content="{Binding Spotify}"
                                    ToolTip.Tip="Lets blocks play, queue and skip songs and add them to playlists, on the Spotify app that's open (needs Premium). The first time it shows a login link in the console"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
