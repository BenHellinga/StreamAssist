<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Input.UI.InputComponentView"
             x:DataType="input:InputComponentViewModel"

             xmlns:input="using:StreamAssist.Components.Input.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- the config bar (every keyboard's keys switch with it), a divider, then the input device boxes | the input device
         list past a splitter (like the Dashboard's dock list) -->

    <DockPanel>

        <ContentControl DockPanel.Dock="Top" Content="{Binding InputList.ConfigBar}" Margin="{s:Gap PadAll}"/>

        <Border DockPanel.Dock="Top" Classes="Divider"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding InputDeviceListWidth, Mode=TwoWay}" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <input:InputListView Grid.Column="0" DataContext="{Binding InputList}"/>

            <GridSplitter Grid.Column="1" Classes="ColumnSplitter"/>

            <input:InputDevicePaletteView Grid.Column="2" DataContext="{Binding Palette}"/>
        </Grid>

    </DockPanel>

</UserControl>
