<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.AppAction.UI.ActionListView"
             x:DataType="ui:ActionListViewModel"

             xmlns:ui="using:StreamAssist.Components.AppAction.UI">

    <!-- action list -->

    <DockPanel Margin="5">

        <TextBlock DockPanel.Dock="Top"
                   Classes="Label"
                   Text="Actions"
                   Margin="{StaticResource PanelGapBottom}"/>

        <!-- list of action cards (each ActionCardViewModel becomes an ActionCardView through the ViewLocator) -->

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
