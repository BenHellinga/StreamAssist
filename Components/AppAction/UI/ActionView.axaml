<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.AppAction.UI.ActionView"
             x:DataType="ui:ActionViewModel"

             xmlns:ui="using:StreamAssist.Components.AppAction.UI"
             xmlns:configurator="using:StreamAssist.Components.Core.Configurator">

    <!-- action -->

    <Border HorizontalAlignment="Left">
        <Grid>

            <StackPanel Margin="5">

                <TextBlock Classes="Title" Text="{Binding Name}" Margin="5"/>
                <TextBlock Classes="Description" Text="{Binding Description}" Margin="5,0,5,5"/>

                <ItemsControl ItemsSource="{Binding Configurators}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="configurator:ConfigurableParameterViewModel">
                            <ContentControl Content="{Binding}" Margin="5,0,5,5"
                                            ContentTemplate="{Binding Configurator, Converter={StaticResource ConfiguratorTemplateSelector}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" Margin="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top">

                <Border Classes="Draggable"
                        Width="15" Height="15"
                        PointerPressed="OnHandlePointerPressed">
                    <TextBlock Text="⠿" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Button Classes="RemoveAction"
                        Width="15" Height="15"
                        Padding="0"
                        Command="{Binding RemoveActionRequestedCommand}">
                    <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                </Button>

            </StackPanel>

        </Grid>
    </Border>

</UserControl>