<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.AppAction.UI.ActionGroupView"
             x:DataType="appAction:ActionGroupViewModel"
             xmlns:appAction="using:StreamAssist.Components.AppAction.UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False"
                  Margin="0,5">

        <StackPanel Margin="5,0,10,200">

            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="appAction:ActionViewModel">
                        <StackPanel Spacing="5">

                            <Border Classes="Droppable"
                                    HorizontalAlignment="Left"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnZoneDragOver"
                                    DragDrop.DragLeave="OnZoneDragLeave"
                                    DragDrop.Drop="OnZoneDrop"
                                    Width="100" Height="25">
                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <appAction:ActionView DataContext="{Binding}"/>
                            
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="Droppable"
                    HorizontalAlignment="Left"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnZoneDragOver"
                    DragDrop.DragLeave="OnZoneDragLeave"
                    DragDrop.Drop="OnZoneDrop"
                    Width="100" Height="25">
                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>