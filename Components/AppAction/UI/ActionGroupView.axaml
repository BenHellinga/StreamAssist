<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.AppAction.UI.ActionGroupView"
             x:DataType="appAction:ActionGroupViewModel"

             xmlns:appAction="using:StreamAssist.Components.AppAction.UI">

    <!-- action group -->

    <ItemsControl ItemsSource="{Binding Actions}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="5"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="appAction:ActionViewModel">
                <appAction:ActionView DataContext="{Binding}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>

    </ItemsControl>

</UserControl>