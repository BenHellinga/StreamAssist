<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.ValueSlotListView"
             x:DataType="ui:ValueSlotListViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- one value slot per item, the last one is always empty. Dropping an item's block on another item moves it before
         that one (the line above it lights up; on a typed box the box passes it on, see ValueSlotViewModel.PassesOn) -->

    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:ValueSlotViewModel">
                <Border Classes="Droppable InsertBefore"
                        DragDrop.DragOver="OnZoneDragOver"
                        DragDrop.DragLeave="OnZoneDragLeave"
                        DragDrop.Drop="OnZoneDrop">
                    <ui:ValueSlotView/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
