<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockCardView"
             x:DataType="ui:BlockCardViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- block card in the block list -->

    <Border Classes="Panel Draggable"
            PointerPressed="OnPointerPressed">

        <StackPanel>
            <!-- name | what a value block gives (the slots it fits), muted -->
            <DockPanel Margin="5,5,5,2">
                <TextBlock DockPanel.Dock="Right" Classes="Description" Text="{Binding TypeText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" IsVisible="{Binding TypeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Classes="Label" Text="{Binding Name}"/>
            </DockPanel>
            <TextBlock Classes="Description" Margin="5,0,5,5"
                       Text="{Binding Description}"
                       MaxLines="2"/>
        </StackPanel>
    </Border>

</UserControl>
