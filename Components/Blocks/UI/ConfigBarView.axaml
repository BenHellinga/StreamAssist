<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.ConfigBarView"
             x:DataType="ui:ConfigBarViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- Config [configs] [name box] ＋ －: a header row, so it's ControlHeight tall like the other headers -->

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" Height="{DynamicResource ControlHeight}">

        <TextBlock Classes="Label" Text="Config" VerticalAlignment="Center"/>

        <ComboBox ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}"
                  Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalAlignment="Center"/>

        <TextBox Classes.New="{Binding NewName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                 Text="{Binding NewName}" PlaceholderText="New config…" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}"

                 Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center"/>

        <Button Classes="Square Medium" Content="＋" Command="{Binding CreatePressedCommand}" VerticalAlignment="Center"/>

        <!-- square like ＋ until it's armed and says "Delete?" -->
        <Button Classes="Medium" Classes.Square="{Binding !IsDeleteArmed}" Content="{Binding DeleteText}" Command="{Binding DeletePressedCommand}"
                VerticalAlignment="Center" IsVisible="{Binding HasConfig}" HorizontalContentAlignment="Center"/>

    </StackPanel>

</UserControl>
