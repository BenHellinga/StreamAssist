<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockView"
             x:DataType="ui:BlockViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:configurator="using:StreamAssist.Components.Blocks.UI.Configurator">

    <Panel HorizontalAlignment="Left">

        <!-- collapsed: a small box the size of a drop zone, same outline as the card, click to expand -->

        <Border Classes="Panel Bound Clickable"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding IsCollapsed}"
                Width="100" Height="25" HorizontalAlignment="Left"
                ToolTip.Tip="{Binding Name}"
                PointerPressed="OnCollapsedPointerPressed">
            <TextBlock Text="▾" HorizontalAlignment="Center"/>
        </Border>

        <!-- block card -->

        <Border Classes="Panel Bound"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding !IsCollapsed}"
                HorizontalAlignment="Left">
            <StackPanel>

                <!-- title | corner buttons, side by side so the buttons never cover the title
                     (the card is at least title + buttons wide, wider content just stretches the gap between them) -->

                <Grid ColumnDefinitions="*,Auto">
                    <!-- placed blocks only show their name, the description is in the block list (and on hover here) -->
                    <TextBlock Grid.Column="0" Classes="Title" Text="{Binding Name}" Margin="10,10,5,5" ToolTip.Tip="{Binding Description}"/>
                    <ui:EditButtons Grid.Column="1"/>
                </Grid>

                <StackPanel Margin="5,0,5,5">

                    <!-- one row per configurable parameter, template picked by ConfiguratorTemplateSelector -->

                    <ItemsControl ItemsSource="{Binding Configurators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="configurator:ConfigurableParameterViewModel">
                                <ContentControl Content="{Binding}" Margin="5,0,5,5"
                                                ContentTemplate="{Binding Configurator, Converter={StaticResource ConfiguratorTemplateSelector}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- nested slots (each becomes a BlockSlotView or BlockSlotListView through the ViewLocator) -->

                    <ItemsControl ItemsSource="{Binding Slots}" Margin="5,0,5,5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </StackPanel>

            </StackPanel>
        </Border>

    </Panel>

</UserControl>
