<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockView"
             x:DataType="ui:BlockViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:configurator="using:StreamAssist.Components.Blocks.UI.Configurator"
        xmlns:s="using:StreamAssist.Styles">

    <!-- top-left, never stretched to fill whatever it sits in (e.g. the editor's scroll area). Its border is a line: a
         LineGap ring inside it (LineZoneAll), nested blocks at the ring, content ContentPadding further in. Empty slots
         and value boxes pad themselves (the styles below, which reach every slot inside this block), so a block placed
         in one fills that space and its border lands at the ring -->

    <UserControl.Styles>
        <!-- an empty slot is a row like a value box: its sides padded, rows spaced by the list they're in (a block placed
             in it fills to the ring at the sides) -->
        <Style Selector="ui|DropZone">
            <Setter Property="Margin" Value="{s:Gap PadSides}"/>
        </Style>
        <!-- a value box is a text row: its sides padded (after a label, only its right: the label keeps the gap), its
             rows spaced by the list they're in -->
        <Style Selector="Border.ValueDrop">
            <Setter Property="Margin" Value="{s:Gap ValueDropMargin}"/>
        </Style>
        <Style Selector="Border.ValueDrop.Labelled">
            <Setter Property="Margin" Value="{s:Gap ValueDropAfterLabelMargin}"/>
        </Style>

        <Style Selector="TextBlock.BlockTitle">
            <Setter Property="Margin" Value="{s:Gap BlockTitleMargin}"/>
        </Style>
        <Style Selector="TextBlock.BlockTitle.HasBody">
            <Setter Property="Margin" Value="{s:Gap BlockTitleBodyMargin}"/>
        </Style>
        <Style Selector="ItemsControl.Settings.PadBelow">
            <Setter Property="Margin" Value="{s:Gap PadBelow}"/>
        </Style>
        <Style Selector="ItemsControl.Slots.AfterSettings">
            <Setter Property="Margin" Value="{s:Gap BlockSlotsMargin}"/>
        </Style>
        <Style Selector="ItemsControl.Slots.PadBelow">
            <Setter Property="Margin" Value="{s:Gap PadBelow}"/>
        </Style>
        <Style Selector="ItemsControl.Slots.AfterSettings.PadBelow">
            <Setter Property="Margin" Value="{s:Gap BlockSlotsPadBelowMargin}"/>
        </Style>
    </UserControl.Styles>

    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- collapsed: a small box the size of a drop zone, same outline as the card, click to expand -->

        <Border Classes="Panel Bound Clickable"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding IsCollapsed}"
                Width="{DynamicResource ControlMinWidth}" Height="{DynamicResource ControlHeight}" HorizontalAlignment="Left"

                PointerPressed="OnCollapsedPointerPressed">
            <TextBlock Text="▾" HorizontalAlignment="Center"/>
        </Border>

        <!-- block card -->

        <Border Classes="Panel Bound"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding !IsCollapsed}"
                HorizontalAlignment="Left"
                x:Name="Card" Padding="{s:Gap LineZoneAll}"
                PointerExited="OnCardPointerExited">
            <StackPanel>

                <!-- title | corner buttons, side by side so the buttons never cover the title
                     (the card is at least title + buttons wide, wider content just stretches the gap between them) -->

                <Grid ColumnDefinitions="*,Auto">
                    <!-- placed blocks only show their name, the description is in the block list (and on hover here) -->
                    <TextBlock Grid.Column="0" Classes="Title BlockTitle" Classes.HasBody="{Binding HasBody}" Text="{Binding Name}"/>
                    <!-- only shown while the pointer is on this card (not a block inside it), hidden by opacity so the
                         title row keeps its size -->
                    <ui:EditButtons Grid.Column="1" x:Name="Buttons" Opacity="0" IsHitTestVisible="False" Margin="{s:Gap RingCornerMargin}"/>
                </Grid>

                <!-- settings, then the slots under them (or beside them, for blocks that ask), MediumVerticalGap under the
                     title, rows SmallVerticalGap apart -->

                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" Margin="{s:Gap BlockBodyTop}" IsVisible="{Binding HasBody}">

                    <!-- one row per configurable parameter, template picked by ConfiguratorTemplateSelector -->

                    <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Configurators}"
                                  Classes="Settings" Classes.PadBelow="{Binding SettingsPadBelow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="configurator:ConfigurableParameterViewModel">
                                <ContentControl Content="{Binding}" Margin="{s:Gap PadSides}"
                                                ContentTemplate="{Binding Configurator, Converter={StaticResource ConfiguratorTemplateSelector}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- nested slots (each becomes a BlockSlotView or BlockSlotListView through the ViewLocator) -->

                    <ItemsControl Grid.Row="{Binding SlotsRow}" Grid.Column="{Binding SlotsColumn}"
                                  ItemsSource="{Binding Slots}"
                                  Classes="Slots" Classes.AfterSettings="{Binding SlotsAfterSettings}" Classes.PadBelow="{Binding SlotsPadBelow}"
                                  IsVisible="{Binding HasSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </Grid>

            </StackPanel>
        </Border>

    </Panel>

</UserControl>
