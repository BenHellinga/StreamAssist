<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockView"
             x:DataType="ui:BlockViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:configurator="using:StreamAssist.Components.Blocks.UI.Configurator"
        xmlns:s="using:StreamAssist.Styles">

    <!-- top-left, never stretched to fill whatever it sits in (e.g. the editor's scroll area). Its border is a line: a
         LineGap ring inside it (LineZoneAll), nested blocks at the ring, content ContentPadding further in. Empty slots
         and value boxes pad themselves (the styles below, which reach every slot inside this block), so a block placed
         in one fills that space and its border lands at the ring -->

    <UserControl.Styles>
        <Style Selector="ui|DropZone">
            <Setter Property="Margin" Value="{s:Gap PadAll}"/>
        </Style>
        <Style Selector="Border.ValueDrop">
            <Setter Property="Margin" Value="{s:Gap PadAll}"/>
        </Style>
    </UserControl.Styles>

    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">

        <!-- collapsed: a small box the size of a drop zone, same outline as the card, click to expand -->

        <Border Classes="Panel Bound Clickable"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding IsCollapsed}"
                Width="100" Height="25" HorizontalAlignment="Left"

                PointerPressed="OnCollapsedPointerPressed">
            <TextBlock Text="▾" HorizontalAlignment="Center"/>
        </Border>

        <!-- block card -->

        <Border Classes="Panel Bound"
                Classes.Triggered="{Binding IsTriggered}"
                Classes.Disabled="{Binding IsDisabled}"
                IsVisible="{Binding !IsCollapsed}"
                HorizontalAlignment="Left"
                x:Name="Card" Padding="{s:Gap LineZoneAll}"
                PointerExited="OnCardPointerExited">
            <StackPanel>

                <!-- title | corner buttons, side by side so the buttons never cover the title
                     (the card is at least title + buttons wide, wider content just stretches the gap between them) -->

                <Grid ColumnDefinitions="*,Auto">
                    <!-- placed blocks only show their name, the description is in the block list (and on hover here) -->
                    <TextBlock Grid.Column="0" Classes="Title" Text="{Binding Name}" Margin="{s:Gap BlockTitleMargin}"/>
                    <!-- only shown while the pointer is on this card (not a block inside it), hidden by opacity so the
                         title row keeps its size -->
                    <ui:EditButtons Grid.Column="1" x:Name="Buttons" Opacity="0" IsHitTestVisible="False" Margin="{s:Gap RingCornerMargin}"/>
                </Grid>

                <!-- settings, then the slots under them (or beside them, for blocks that ask) -->

                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto">

                    <!-- one row per configurable parameter, template picked by ConfiguratorTemplateSelector -->

                    <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Configurators}" Margin="{s:Gap PadBelow}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="configurator:ConfigurableParameterViewModel">
                                <ContentControl Content="{Binding}" Margin="{s:Gap BlockBodyMargin}"
                                                ContentTemplate="{Binding Configurator, Converter={StaticResource ConfiguratorTemplateSelector}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- nested slots (each becomes a BlockSlotView or BlockSlotListView through the ViewLocator) -->

                    <ItemsControl Grid.Row="{Binding SlotsRow}" Grid.Column="{Binding SlotsColumn}"
                                  ItemsSource="{Binding Slots}" Margin="{s:Gap BlockSlotsMargin}"
                                  IsVisible="{Binding HasSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </Grid>

            </StackPanel>
        </Border>

    </Panel>

</UserControl>
