<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockSlotView"
             x:DataType="ui:BlockSlotViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- single slot -->

    <StackPanel Spacing="5">

        <TextBlock Classes="Label" Text="{Binding Label}" IsVisible="{Binding HasLabel}"/>

        <!-- empty: drop zone -->

        <ui:DropZone IsCondition="{Binding IsConditionSlot}"
                     IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNull}}"
                     DragDrop.DragOver="OnZoneDragOver"
                     DragDrop.DragLeave="OnZoneDragLeave"
                     DragDrop.Drop="OnZoneDrop"/>

        <!-- filled: the block's card (a BlockView through the ViewLocator) -->

        <ContentControl Content="{Binding Block}"
                        IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    </StackPanel>

</UserControl>
