<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockSlotView"
             x:DataType="ui:BlockSlotViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- single slot: its label (if any) in the fixed label column beside it, so it lines up with an if's branches -->

    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Panel Grid.Column="0" Width="{StaticResource SlotLabelWidth}" IsVisible="{Binding HasLabel}">
            <TextBlock Classes="Label SlotLabel" Text="{Binding Label}"/>
        </Panel>

        <!-- empty: drop zone -->

        <ui:DropZone Grid.Column="1"
                     IsCondition="{Binding IsConditionSlot}"
                     IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNull}}"
                     DragDrop.DragOver="OnZoneDragOver"
                     DragDrop.DragLeave="OnZoneDragLeave"
                     DragDrop.Drop="OnZoneDrop"/>

        <!-- filled: the block's card (a BlockView through the ViewLocator) -->

        <ContentControl Grid.Column="1" Content="{Binding Block}"
                        IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    </Grid>

</UserControl>
