<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.ValueSlotView"
             x:DataType="ui:ValueSlotViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- label | typed value (a drop target for value blocks) or the placed value block's card, with an optional
         connector line above the value (e.g. Equals: value, ==, value) -->

    <!-- the label carries its own gap, so a slot without one (Expression, name / value rows) has none either -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

        <TextBlock Grid.Column="1" Grid.Row="0" Classes="Label" Text="{Binding Connector}" IsVisible="{Binding HasConnector}"
                   Margin="{s:Gap ConnectorMargin}"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Classes="Label" Text="{Binding Label}" IsVisible="{Binding HasLabel}" Margin="{s:Gap SlotLabelMargin}"/>

        <!-- empty or typed: the placeholder says what fits, e.g. "+ int" (the border lights up when a block can be dropped) -->

        <!-- left-aligned: the column stretches when the row beside it is wider, a box with a max width would be centred in it -->
        <Border Grid.Column="1" Grid.Row="1" Classes="Droppable ValueDrop" Classes.Labelled="{Binding HasLabel}" HorizontalAlignment="Left"
                IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNull}}"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnDragOver"
                DragDrop.DragLeave="OnDragLeave"
                DragDrop.Drop="OnDrop">
            <!-- room on the right for the paste button (PasteBoxPadding), like a bind box keeps for its buttons -->
            <Panel>
            <TextBox HorizontalAlignment="Left" Padding="{s:Gap PasteBoxPadding}" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Classes.New="{Binding IsNewEntry}"
                     AcceptsReturn="{Binding IsText}" AcceptsTab="False" TextWrapping="Wrap"/>
            <ui:PasteButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{s:Gap PasteInBoxMargin}"/>
            </Panel>
        </Border>

        <!-- a value block placed here (a BlockView through the ViewLocator) -->

        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding Block}"
                        IsVisible="{Binding Block, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    </Grid>

    <UserControl.Styles>
        <Style Selector="Border.ValueDrop">
            <Setter Property="BorderThickness" Value="{s:Gap BorderAll}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{s:Gap Corners}"/>
        </Style>
    </UserControl.Styles>

</UserControl>
