<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockBranchListView"
             x:DataType="ui:BlockBranchListViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- if / else if branches -->

    <StackPanel Spacing="5">

        <ItemsControl ItemsSource="{Binding Branches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- condition drop zone above each branch, then the branch itself -->

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ui:BlockBranchViewModel">
                    <StackPanel Spacing="5">

                        <Border Classes="Panel Droppable DropZone"
                                DragDrop.DragOver="OnZoneDragOver"
                                DragDrop.DragLeave="OnZoneDragLeave"
                                DragDrop.Drop="OnZoneDrop">
                            <TextBlock Text="+ condition"/>
                        </Border>

                        <TextBlock Classes="Label" Text="{Binding Header}"/>
                        <ContentControl Content="{Binding Condition}"/>

                        <TextBlock Classes="Label" Text="then"/>
                        <ContentControl Content="{Binding Then}"/>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- condition drop zone at the end -->

        <Border Classes="Panel Droppable DropZone"
                DragDrop.DragOver="OnZoneDragOver"
                DragDrop.DragLeave="OnZoneDragLeave"
                DragDrop.Drop="OnZoneDrop">
            <TextBlock Text="+ condition"/>
        </Border>

    </StackPanel>

</UserControl>
