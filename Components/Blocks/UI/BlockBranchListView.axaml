<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockBranchListView"
             x:DataType="ui:BlockBranchListViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- if / else if branches: the condition beside its "if" / "else if" and the then slot under it (lined up with the
         block's "else"), dropping a condition on a branch starts a new branch before it -->

    <StackPanel Spacing="5">

        <ItemsControl ItemsSource="{Binding Branches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ui:BlockBranchViewModel">
                    <Border Classes="Droppable InsertBefore"
                            DragDrop.DragOver="OnZoneDragOver"
                            DragDrop.DragLeave="OnZoneDragLeave"
                            DragDrop.Drop="OnZoneDrop">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Panel Grid.Row="0" Grid.Column="0" Width="{StaticResource SlotLabelWidth}">
                                <TextBlock Classes="Label SlotLabel" Text="{Binding Header}"/>
                            </Panel>
                            <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Condition}"/>

                            <!-- the then slot has no label, it sits under its condition in the slot column -->
                            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Then}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- condition drop zone at the end (a new last "else if"), lined up with the slots above -->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Panel Grid.Column="0" Width="{StaticResource SlotLabelWidth}"/>
            <ui:DropZone Grid.Column="1" IsCondition="True"
                         DragDrop.DragOver="OnZoneDragOver"
                         DragDrop.DragLeave="OnZoneDragLeave"
                         DragDrop.Drop="OnZoneDrop"/>
        </Grid>

    </StackPanel>

</UserControl>
