<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.DropZone">

    <!-- the one place that decides what a block drop target looks like, every slot uses this control
         (the borders need the Droppable class, it's how DropBehaviorHandler finds them) -->

    <UserControl.Styles>
        <Style Selector="Border.DropZone">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="DragDrop.AllowDrop" Value="True"/>
        </Style>
        <Style Selector="Border.DropZone > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- an empty slot is a ghost field like the "new" boxes (TextBox.New): barely there, it still lights up when a
             block can be dropped on it (Border.Droppable.Dragover in Border.axaml) -->
        <Style Selector="Border.DropZone:not(.Dragover)">
            <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}"/>
        </Style>
        <!-- half strength, like the theme draws a text box's placeholder, so the + and "New …" texts look the same -->
        <Style Selector="Border.DropZone:not(.Dragover) > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GhostText}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- slot for blocks that run (containers, actions) -->

        <Border x:Name="BlockZone" Classes="Panel Droppable DropZone">
            <TextBlock Text="+"/>
        </Border>

        <!-- slot for conditions -->

        <Border x:Name="ConditionZone" Classes="Panel Droppable DropZone" IsVisible="False">
            <TextBlock Text="+ condition"/>
        </Border>

    </Panel>

</UserControl>
