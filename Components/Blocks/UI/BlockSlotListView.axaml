<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockSlotListView"
             x:DataType="ui:BlockSlotListViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- list slot: dropping on a block puts the new one before it (a line above it lights up), the zone at the end adds
         it last, so reordering is dragging a block onto the one it should go before -->

    <StackPanel Spacing="5">

        <TextBlock Classes="Label" Text="{Binding Label}" IsVisible="{Binding HasLabel}"/>

        <ItemsControl ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ui:BlockViewModel">
                    <Border Classes="Droppable InsertBefore"
                            DragDrop.DragOver="OnZoneDragOver"
                            DragDrop.DragLeave="OnZoneDragLeave"
                            DragDrop.Drop="OnZoneDrop">
                        <ui:BlockView/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- drop zone at the end -->

        <ui:DropZone IsCondition="{Binding IsConditionSlot}"
                     DragDrop.DragOver="OnZoneDragOver"
                     DragDrop.DragLeave="OnZoneDragLeave"
                     DragDrop.Drop="OnZoneDrop"/>

    </StackPanel>

</UserControl>
