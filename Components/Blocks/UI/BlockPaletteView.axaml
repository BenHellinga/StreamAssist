<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockPaletteView"
             x:DataType="ui:BlockPaletteViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- search box | block list -->

    <DockPanel>

        <!-- search (filters as you type, after a short pause), a header row like a tab strip so its divider lines up
             with the one beside it -->

        <ui:ListSearchView DockPanel.Dock="Top" Margin="{s:Gap PadAll}"/>

        <Border DockPanel.Dock="Top" Classes="Divider"/>

        <TextBlock DockPanel.Dock="Top" Margin="{s:Gap TopInset}"
                   Classes="Description"
                   Text="No matching blocks"
                   IsVisible="{Binding !HasResults}"/>

        <!-- a heading per group (click to collapse / expand), its cards below (each card is a BlockCardView through the
             ViewLocator) -->

        <ScrollViewer Classes="Gapped">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="{s:Gap ScrollInset}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ui:BlockGroupViewModel">
                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}">

                            <!-- the title, then the arrow: only the arrow (a small button) collapses / expands -->
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                                <TextBlock Classes="Label" Text="{Binding HeadingText}" VerticalAlignment="Center"/>
                                <Button Classes="Square Small" Content="{Binding Arrow}" Command="{Binding HeadingPressedCommand}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding ShowCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- its subgroups (e.g. Twitch > Moderation), indented: a heading and cards each, collapsed the same way -->
                            <ItemsControl ItemsSource="{Binding Subgroups}" IsVisible="{Binding ShowCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:BlockGroupViewModel">
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}" Margin="{s:Gap SubgroupIndent}">
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                                                <TextBlock Classes="Label" Text="{Binding HeadingText}" VerticalAlignment="Center"/>
                                                <Button Classes="Square Small" Content="{Binding Arrow}" Command="{Binding HeadingPressedCommand}"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding ShowCards}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
