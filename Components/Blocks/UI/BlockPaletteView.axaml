<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockPaletteView"
             x:DataType="ui:BlockPaletteViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- search box | block list -->

    <DockPanel>

        <!-- search (filters as you type, after a short pause), a header row like a tab strip so its divider lines up
             with the one beside it -->

        <TextBox DockPanel.Dock="Top"
                 Margin="{StaticResource HeaderMargin}"
                 Height="{StaticResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center"
                 Text="{Binding SearchText}"
                 PlaceholderText="Search blocks…"/>

        <Border DockPanel.Dock="Top" Margin="{StaticResource DividerMargin}" Classes="Divider"/>

        <TextBlock DockPanel.Dock="Top" Margin="5,5,5,0"
                   Classes="Description"
                   Text="No matching blocks"
                   IsVisible="{Binding !HasResults}"/>

        <!-- a heading per group (click to collapse / expand), its cards below (each card is a BlockCardView through the
             ViewLocator) -->

        <ScrollViewer Classes="Gapped">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="5,0,5,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ui:BlockGroupViewModel">
                        <StackPanel Spacing="5">

                            <!-- the title, then the arrow: only the arrow (a small button) collapses / expands -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <TextBlock Classes="Label" Text="{Binding HeadingText}" VerticalAlignment="Center"/>
                                <Button Classes="Square Small" Content="{Binding Arrow}" Command="{Binding HeadingPressedCommand}"
                                        VerticalAlignment="Center" ToolTip.Tip="Collapse / expand"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding ShowCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
