<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BlockPaletteView"
             x:DataType="ui:BlockPaletteViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI">

    <!-- search box | block list -->

    <DockPanel Margin="5">

        <!-- search (filters as you type, after a short pause) -->

        <TextBox DockPanel.Dock="Top"
                 Margin="{StaticResource PanelGapBottom}"
                 Text="{Binding SearchText}"
                 PlaceholderText="Search blocks…"/>

        <TextBlock DockPanel.Dock="Top"
                   Classes="Description"
                   Text="No matching blocks"
                   IsVisible="{Binding !HasResults}"/>

        <!-- a heading per category, its cards below (each card is a BlockCardView through the ViewLocator) -->

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ui:BlockCategoryGroup">
                        <StackPanel Spacing="5">

                            <TextBlock Classes="Label" Text="{Binding Title}"/>

                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
