<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.EditButtons"
             x:DataType="ui:IEditButtons"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:controls="using:StreamAssist.Core.Controls"
        xmlns:s="using:StreamAssist.Styles">

    <!-- small corner buttons for a key or block. Where they don't all fit (a small key), the least important are left
         out first (PriorityStackPanel: higher Priority stays longest): drag and remove stay, then collapse, on/off, and
         copy goes first (a key's script can still be copied from its blocks) -->

    <controls:PriorityStackPanel Spacing="{DynamicResource CornerGap}" Margin="{s:Gap CornerMargin}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top">

        <!-- copy (BlockClipboard): a block's tree, a key's or bind box's whole binding, a keyboard box -->

        <Button Classes="Square Small Copy" controls:PriorityStackPanel.Priority="-1"
                Command="{Binding CopyButtonPressedCommand}"
                IsVisible="{Binding CanCopy}">
            <Path Classes="Icon Line" Data="{StaticResource CopyIcon}"/>
        </Button>

        <!-- collapse (blocks only) -->

        <Button Classes="Square Small Collapse" controls:PriorityStackPanel.Priority="1"
                Content="▴"
                Command="{Binding CollapseButtonPressedCommand}"
                IsVisible="{Binding CanCollapse}"/>

        <!-- switch off (－, while it's on) / back on (＋, while it's off), not on docks -->

        <Button Classes="Square Small ToggleEnabled" controls:PriorityStackPanel.Priority="0"
                Command="{Binding ToggleButtonPressedCommand}"
                IsVisible="{Binding CanToggle}">
            <Panel>
                <TextBlock Text="－" IsVisible="{Binding !IsDisabled}"/>
                <TextBlock Text="＋" IsVisible="{Binding IsDisabled}"/>
            </Panel>
        </Button>

        <!-- drag handle (same size as the Small buttons next to it) -->

        <Border Classes="Panel Draggable" controls:PriorityStackPanel.Priority="3"
                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}"
                PointerPressed="OnHandlePointerPressed">
            <TextBlock Text="⠿" HorizontalAlignment="Center"/>
        </Border>

        <!-- remove -->

        <Button Classes="Square Small RemoveAction" controls:PriorityStackPanel.Priority="2"
                Content="X"
                Command="{Binding RemoveButtonPressedCommand}"/>

    </controls:PriorityStackPanel>

</UserControl>
