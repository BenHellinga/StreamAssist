<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BindableEditorView"
             x:DataType="ui:BindableEditorViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:model="using:StreamAssist.Components.Blocks.Model">

    <!-- editor | block list -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="{StaticResource SplitterLength}"/>
            <ColumnDefinition Width="{Binding BlockListWidth, Mode=TwoWay}" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- editor -->

        <Grid Grid.Column="0">

            <!-- nothing selected -->

            <TextBlock Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !HasBindable}"/>

            <!-- header | root slot -->

            <Grid IsVisible="{Binding HasBindable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- header: what's being edited | the Parameters toggle (only when the trigger has parameters) -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15"
                            Margin="{StaticResource HeaderMargin}" Height="{StaticResource HeaderHeight}">
                    <!-- what it is, then its label box after the same gap the text itself uses ("Key: 7     Config: ...") -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="Label" Text="{Binding Label}" VerticalAlignment="Center"/>
                        <TextBlock Classes="Label" Text="     Label: " VerticalAlignment="Center"/>
                        <!-- greyed out until there's a saved binding with blocks (a draft or an empty one can't be labelled) -->
                        <TextBox Width="250" MinHeight="0" VerticalAlignment="Center" Text="{Binding BindLabel}" PlaceholderText="Optional"
                                 IsEnabled="{Binding CanEditBindLabel}"
                                 Classes="BindLabel" Classes.Disabled="{Binding IsBindDisabled}"
                                 ToolTip.Tip="Shown on its key / bind box as one more line (green, red while disabled)"/>
                    </StackPanel>

                    <Button Command="{Binding ParametersTogglePressedCommand}" IsVisible="{Binding HasParameters}"
                            Height="{StaticResource HeaderHeight}" VerticalContentAlignment="Center"
                            ToolTip.Tip="The parameters this has, for Get Parameter or {name} in typed text">
                        <Panel>
                            <TextBlock Text="Parameters ▸" IsVisible="{Binding !IsParametersOpen}"/>
                            <TextBlock Text="Parameters ▾" IsVisible="{Binding IsParametersOpen}"/>
                        </Panel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Margin="{StaticResource DividerMargin}" Classes="Divider"/>

                <!-- parameters: name | type | what it is, then a divider before the blocks -->

                <StackPanel Grid.Row="2" Spacing="5" IsVisible="{Binding IsParametersOpen}">
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="5,5,5,0" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:ParameterInfo">
                                <Grid ColumnSpacing="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="name"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="kind"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Classes="Description" Text="{Binding Kind}"/>
                                    <TextBlock Grid.Column="2" Classes="Description" Text="{Binding Description}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="{StaticResource DividerMargin}" Classes="Divider"/>
                </StackPanel>

                <!-- the bindable's single slot (a BlockSlotView through the ViewLocator) -->

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Classes="Gapped">
                    <!-- the padding is room to scroll the last block up (Spacing.axaml ScrollEndPadding) -->
                    <Border Padding="{StaticResource ScrollEndPadding}">
                        <ContentControl Content="{Binding RootSlot}" Margin="5,5,10,0"/>
                    </Border>
                </ScrollViewer>

            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Margin="{StaticResource ColumnSplitterMargin}" Classes="ColumnSplitter"/>

        <!-- block list -->

        <ui:BlockPaletteView Grid.Column="2" DataContext="{Binding Palette}"/>

    </Grid>

</UserControl>
