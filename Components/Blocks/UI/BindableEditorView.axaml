<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Blocks.UI.BindableEditorView"
             x:DataType="ui:BindableEditorViewModel"

             xmlns:ui="using:StreamAssist.Components.Blocks.UI"
             xmlns:model="using:StreamAssist.Components.Blocks.Model"
             xmlns:console="using:StreamAssist.Components.OutputConsole.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- editor | block list -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{Binding BlockListWidth, Mode=TwoWay}" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- editor -->

        <!-- clipped, so a header wider than the column (block list dragged left) doesn't draw over the list -->
        <Grid Grid.Column="0" ClipToBounds="True">

            <!-- nothing selected -->

            <TextBlock Text="{Binding EmptyText}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !HasBindable}"/>

            <!-- header | root slot -->

            <Grid IsVisible="{Binding HasBindable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- header: what's being edited and its label, then Test (runs it once with the Parameters list's values),
                     the Parameters toggle, and Switch to C# / Blocks (which one runs) -->

                <StackPanel Grid.Row="0" Spacing="{DynamicResource SmallVerticalGap}" Margin="{s:Gap PadAll}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource LargeHorizontalGap}" Height="{DynamicResource ControlHeight}">
                        <!-- what it is | "Label:" and its box -->
                        <TextBlock Classes="Label" Text="{Binding Label}" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                            <TextBlock Classes="Label Colon" Text="Label:" VerticalAlignment="Center"/>
                            <!-- greyed out until there's a saved binding with blocks or a script (a draft or an empty one can't be labelled) -->
                            <TextBox MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding BindLabel}" PlaceholderText="Optional"
                                     IsEnabled="{Binding CanEditBindLabel}"
                                     Classes="BindLabel" Classes.Disabled="{Binding IsBindDisabled}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" Height="{DynamicResource ControlHeight}">
                        <Button Content="Test" Command="{Binding TestPressedCommand}"
                                Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding ParametersTogglePressedCommand}"
                                Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center">
                            <Panel>
                                <TextBlock Text="Parameters ▸" IsVisible="{Binding !IsParametersOpen}"/>
                                <TextBlock Text="Parameters ▾" IsVisible="{Binding IsParametersOpen}"/>
                            </Panel>
                        </Button>

                        <!-- the blocks and the script are both kept, only the one picked runs -->
                        <Button Command="{Binding ModeTogglePressedCommand}"
                                Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center">
                            <Panel>
                                <TextBlock Text="Switch to C#" IsVisible="{Binding !IsCSharp}"/>
                                <TextBlock Text="Switch to Blocks" IsVisible="{Binding IsCSharp}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Classes="Divider"/>

                <!-- parameters: name | the value Test uses | type | what it is, then the extra name / value rows (the last
                     one empty, typing in it adds the next), then a divider before the blocks -->

                <StackPanel Grid.Row="2" Spacing="{DynamicResource SmallVerticalGap}" IsVisible="{Binding IsParametersOpen}">
                    <StackPanel Spacing="{DynamicResource SmallVerticalGap}" Margin="{s:Gap TopInset}" Grid.IsSharedSizeScope="True">
                        <ItemsControl ItemsSource="{Binding TestParameters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:TestParameterViewModel">
                                    <Grid ColumnSpacing="{DynamicResource SmallHorizontalGap}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="name"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="value"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="kind"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" MinWidth="150"/>
                                        <TextBox Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" HorizontalAlignment="Left" Text="{Binding Value}" PlaceholderText="Value…"/>
                                        <TextBlock Grid.Column="2" Classes="Description" Text="{Binding Kind}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Classes="Description" Text="{Binding Description}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ExtraParameters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ui:TestParameterViewModel">
                                    <Grid ColumnSpacing="{DynamicResource SmallHorizontalGap}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="name"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="value"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" HorizontalAlignment="Left" Text="{Binding Name}" PlaceholderText="Extra parameter…"
                                                 Classes.New="{Binding IsEmpty}"/>
                                        <TextBox Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" HorizontalAlignment="Left" Text="{Binding Value}" PlaceholderText="Value…"
                                                 IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Classes="Divider"/>
                </StackPanel>

                <!-- the bindable's root list (a BlockSlotListView through the ViewLocator): its blocks run top to bottom, with no
                     box of its own, and the drop zone at the end is where a block can wait while the rest is rearranged -->

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Classes="Gapped"
                              IsVisible="{Binding !IsCSharp}">
                    <!-- the padding is room to scroll the last block up (Spacing.axaml ScrollEndPadding) -->
                    <Border Padding="{StaticResource ScrollEndPadding}">
                        <ContentControl Content="{Binding RootSlot}" Margin="{s:Gap ScrollInset}"/>
                    </Border>
                </ScrollViewer>

                <!-- C#: the script is edited in VS Code (saving there recompiles it), here its limits and what its compiles said -->

                <DockPanel Grid.Row="3" IsVisible="{Binding IsCSharp}">
                    <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource MediumVerticalGap}" Margin="{s:Gap PadAll}">
                        <Button Content="Open in VS Code" Command="{Binding OpenScriptPressedCommand}"
                                Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center"/>

                        <!-- how far the script may go before it's stopped, in seconds (empty or Off: no limit): a loop going on
                             without waiting, the whole run, and waiting for a table, variable or lock another run has locked.
                             One a row, the boxes lined up -->
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left"
                              ColumnSpacing="{DynamicResource SmallHorizontalGap}" RowSpacing="{DynamicResource SmallVerticalGap}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label Colon" Text="Loop limit (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Classes="Commit" Text="{Binding LoopLimitInput}" PlaceholderText="Off"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label Colon" Text="Run limit (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Classes="Commit" Text="{Binding RunLimitInput}" PlaceholderText="Off"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label Colon" Text="Lock wait (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Classes="Commit" Text="{Binding LockWaitInput}" PlaceholderText="Off"/>
                        </Grid>

                        <!-- title, Clear beside it (as on the output console) -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" Height="{DynamicResource ControlHeight}">
                            <TextBlock Classes="Label" Text="Compile Output" VerticalAlignment="Center"/>
                            <Button Content="Clear" Command="{Binding ClearCompileOutputPressedCommand}"
                                    Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Classes="Divider"/>

                    <!-- this session's compiles of the script ([time]s muted, scrolls to new lines), like the console -->
                    <console:LogView Text="{Binding CompileOutput}"/>
                </DockPanel>

            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Classes="ColumnSplitter"/>

        <!-- block list -->

        <ui:BlockPaletteView Grid.Column="2" DataContext="{Binding Palette}"/>

    </Grid>

</UserControl>
