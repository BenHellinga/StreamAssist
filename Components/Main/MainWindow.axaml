<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StreamAssist.Components.Main"
        xmlns:shell="using:StreamAssist.Components.Main"
        xmlns:keyboard="using:StreamAssist.Components.Keyboard"
        x:Class="StreamAssist.Components.Main.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="StreamAssist"
        Background="#0f0f0f">


    <Window.DataTemplates>
        <DataTemplate DataType="keyboard:KeyboardTabViewModel">
            <keyboard:KeyboardTab DataContext="{Binding}"/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ConsoleWidth, Mode=TwoWay}" MinWidth="120"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ── Output console (full height) ───────────────────────────── -->
        <shell:OutputConsole Grid.Column="0"
                              DataContext="{Binding OutputConsoleViewModel}"/>

        <GridSplitter Grid.Column="1"
                       Width="6"
                       Background="#333333"
                       HorizontalAlignment="Stretch"
                       Cursor="SizeWestEast"/>

        <!-- ── Tab strip + active tab content ──────────────────────────── -->
        <DockPanel Grid.Column="2">

            <ListBox DockPanel.Dock="Top"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Background="#161616"
                     BorderThickness="0,0,0,1"
                     BorderBrush="#333333"
                     Padding="8,6">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Monospace"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#222222"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#7c3aed"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Foreground" Value="#ffffff"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TabItemViewModel">
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Content="{Binding SelectedTab.Content}"/>

        </DockPanel>

    </Grid>

</Window>
