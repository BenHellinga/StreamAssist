<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StreamAssist.Components.Main.MainWindow"
        x:DataType="main:MainWindowViewModel"

        xmlns:main="using:StreamAssist.Components.Main"
        xmlns:keyboard="using:StreamAssist.Components.Keyboard.UI"

        Title="StreamAssist"
        Background="{DynamicResource MainBackground}">

    <!-- tab datatemplates -->

    <Window.DataTemplates>
        <DataTemplate DataType="keyboard:KeyboardTabViewModel">
            <keyboard:KeyboardTab DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="main:OutputConsoleViewModel">
            <keyboard:KeyboardTab DataContext="{Binding}"/>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- main window -->

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="100"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- output console -->

        <main:OutputConsole Grid.Column="0" DataContext="{Binding OutputConsoleViewModel}"/>
        
        <GridSplitter Grid.Column="1" Classes="ColumnSplitter" Margin="0,0,5,0"/>

        <!-- tabs -->

        <DockPanel Grid.Column="2">

            <!-- tab strip -->

            <ListBox Classes="TopTabStrip"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Margin="0,0,0,5">

                <!-- component tab -->

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="main:TabItemViewModel">
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- selected tab content -->

            <ContentControl Content="{Binding SelectedTab.Content}"/>

        </DockPanel>
    </Grid>
</Window>
