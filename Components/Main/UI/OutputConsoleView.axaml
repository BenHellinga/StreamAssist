<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Main.UI.OutputConsoleView"
             x:DataType="main:OutputConsoleViewModel"

             xmlns:main="using:StreamAssist.Components.Main.UI">

    <!-- console panel -->

    <DockPanel>

        <!-- header -->

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,5">

            <TextBlock Grid.Column="0"
                       Classes="Label"
                       Text="Output"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"/>

            <Button Grid.Column="1"
                    Content="Clear"
                    Command="{Binding ClearCommand}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                    
        </Grid>

        <Border DockPanel.Dock="Top" Classes="Divider" Margin="0,0,0,5"/>

        <!-- log messages -->

        <ScrollViewer x:Name="LogScrollViewer">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="OutputLine" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>