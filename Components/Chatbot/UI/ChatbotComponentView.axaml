             x:DataType="ui:ChatbotComponentViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI">

    <!-- the page (ChatCommandsView or ChatEventsView through the ViewLocator) -->

    <ContentControl Content="{Binding Page}"/>

</UserControl>
