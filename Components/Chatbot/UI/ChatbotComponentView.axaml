<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Chatbot.UI.ChatbotComponentView"
             x:DataType="ui:ChatbotComponentViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI">

    <!-- the config bar (the whole page switches with it), a divider, then the page (ChatCommandsView or ChatEventsView
         through the ViewLocator) -->

    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Content="{Binding ConfigBar}" Margin="{StaticResource HeaderMargin}"/>
        <Border DockPanel.Dock="Top" Classes="Divider" Margin="{StaticResource DividerMargin}"/>
        <ContentControl Content="{Binding Page}"/>
    </DockPanel>

</UserControl>
