<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Chatbot.UI.ChatTargetView"
             x:DataType="ui:ChatTargetViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI">

    <!-- the buttons only show while the pointer is on a bind box that has a binding (hidden by opacity, so nothing moves) -->

    <UserControl.Styles>
        <Style Selector="blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.Bound:pointerover > Grid > Panel > blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <!-- the chat block slot | bind box, filling one hides the other -->

    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">

        <!-- keep matching into another chat block (a BlockSlotView through the ViewLocator) -->

        <ContentControl Content="{Binding Child}" IsVisible="{Binding ShowSlot}"/>

        <!-- bind box: shows the command that reaches it (grey preview until bound), click to edit its binding below,
             green = bound, red = disabled, buttons inside while the pointer is on a bound one. A labelled binding gets
             its label as a second line (the box grows taller, and wider for a long label, never wraps) -->

        <Border Classes="Panel Droppable Clickable"
                Classes.Bound="{Binding IsBound}"
                Classes.Disabled="{Binding IsDisabled}"
                Classes.Triggered="{Binding IsTriggered}"
                MinWidth="100" MinHeight="25" VerticalAlignment="Top"
                IsVisible="{Binding ShowBindBox}"
                ToolTip.Tip="{Binding Command}"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnDragOver"
                DragDrop.DragLeave="OnDragLeave"
                DragDrop.Drop="OnDrop"
                PointerPressed="OnBindBoxPointerPressed">

            <!-- text on the left, an invisible copy of the buttons on the right keeps exactly enough room for them,
                 so the text doesn't move when the real buttons appear -->

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                <!-- long commands end in ... (the label line below has no limit) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Command}"
                           Classes.Placeholder="{Binding !IsBound}"
                           Margin="6,0,0,0" MaxWidth="260" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="BindLabel" Classes.Disabled="{Binding IsDisabled}"
                           Text="{Binding BindLabel}" IsVisible="{Binding BindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Margin="6,0,0,2"/>

                <Panel Grid.Row="0" Grid.Column="1">
                    <blocks:EditButtons Opacity="0" IsHitTestVisible="False"/>
                    <blocks:EditButtons Classes="HoverOnly"/>
                </Panel>
            </Grid>
        </Border>

    </StackPanel>

</UserControl>
