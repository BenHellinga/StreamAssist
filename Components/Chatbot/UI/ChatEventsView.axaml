<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Chatbot.UI.ChatEventsView"
             x:DataType="ui:ChatEventsViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- by where things come from: App (the app's own events, e.g. App Started), then Twitch (its alerts, then the
         channel point redeems with New redeem under them). A divider between sources, not between Alerts and
         Redeems. Each section's content is inset, the dividers run edge to edge. Testing is the editor's Test button.
         The config bar sits right above (ChatbotComponentView), the divider under it is this page's first line -->

    <DockPanel>

        <Border DockPanel.Dock="Top" Classes="Divider"/>

        <ScrollViewer Classes="Gapped Lined" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <!-- the padding is room to scroll the last row up (Spacing.axaml ScrollEndPadding) -->
            <Border Padding="{StaticResource ScrollEndPadding}">
                <StackPanel Spacing="{s:Gap ContentPadding}" Margin="{s:Gap ScrollInset}">

                    <!-- app -->

                    <!-- the title font has ~5px of space above its letters, pulled back so the text itself is 10 from the line (the
                         space under it is kept: a big title has more room below) -->
                    <StackPanel Spacing="{DynamicResource LargeVerticalGap}" Margin="{s:Gap PadSides}">
                        <TextBlock Classes="Title UnderLine" Text="App"/>

                        <StackPanel Spacing="{DynamicResource MediumVerticalGap}">
                            <ItemsControl ItemsSource="{Binding AppEvents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <Border Classes="Divider"/>

                    <!-- twitch: alerts (one bind box per stream event), then redeems (one row per reward title, like Match
                         Text rows; dropping a row's binding on another row moves it before that one) -->

                    <StackPanel Spacing="{DynamicResource LargeVerticalGap}" Margin="{s:Gap PadSides}">
                        <TextBlock Classes="Title UnderLine" Text="Twitch"/>

                        <StackPanel Spacing="{DynamicResource MediumVerticalGap}">
                            <TextBlock Classes="Label Subheading" Text="Alerts"/>
                            <ItemsControl ItemsSource="{Binding TwitchEvents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Classes="Label Subheading" Text="Redeems"/>
                            <ItemsControl ItemsSource="{Binding Redeems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:RedeemRowViewModel">
                                        <Border Classes="Droppable InsertBefore"
                                                DragDrop.DragOver="OnRedeemDragOver"
                                                DragDrop.DragLeave="OnRedeemDragLeave"
                                                DragDrop.Drop="OnRedeemDrop">
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                                                <!-- the empty row at the end has a dim border until a title is typed -->
                                                <TextBox MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" VerticalAlignment="Top"
                                                         Classes.New="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                         Text="{Binding Title}" PlaceholderText="New redeem…"/>

                                                <!-- bind box (a ChatTargetView through the ViewLocator), once the row has a title -->
                                                <ContentControl Content="{Binding Target}" IsVisible="{Binding ShowTarget}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- new reward: created on twitch as the streamer, then a redeem row appears for it -->
                            <Button Classes="Tab" Classes.Open="{Binding IsNewRewardOpen}" Content="New redeem" HorizontalAlignment="Left"
                                    Command="{Binding NewRewardTabPressedCommand}"/>
                            <Grid IsVisible="{Binding IsNewRewardOpen}"
                                  ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource SmallVerticalGap}" ColumnSpacing="{DynamicResource SmallHorizontalGap}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="Title" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" HorizontalAlignment="Left" Text="{Binding NewRewardTitle}"
                                         PlaceholderText="Unique on your channel" MaxLength="45"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Cost" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" HorizontalAlignment="Left" Text="{Binding NewRewardCost}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Prompt" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" HorizontalAlignment="Left" Text="{Binding NewRewardPrompt}"
                                         PlaceholderText="What viewers see (optional)"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="Label" Text="Viewer types text" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding NewRewardNeedsInput}" VerticalAlignment="Center"/>
                                <Button Grid.Row="4" Grid.Column="1" Content="Create on Twitch" HorizontalAlignment="Left"
                                        Command="{Binding CreateRewardPressedCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>
