<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Chatbot.UI.ChatCommandsView"
             x:DataType="ui:ChatCommandsViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI">

    <!-- chat command tree | chat block list -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="{StaticResource SplitterLength}"/>
            <ColumnDefinition Width="{Binding ChatBlockListWidth, Mode=TwoWay}" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="*,Auto">

            <!-- the root chat block slot (a BlockSlotView through the ViewLocator), clicking a bind box opens its binding below -->

            <ScrollViewer Grid.Row="0" Classes="Gapped"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <!-- the padding is room to scroll the last block up (Spacing.axaml ScrollEndPadding) -->
                <Border Padding="{StaticResource ScrollEndPadding}">
                    <ContentControl Content="{Binding Root}" Margin="5,5,10,0"/>
                </Border>
            </ScrollViewer>

            <!-- test panel: closed it's one small button, open it sends a made-up chat message through the tree -->

            <StackPanel Grid.Row="1" Spacing="5" Margin="0,0,0,5">
                <Border Classes="Divider"/>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="{StaticResource ContentInset}">
                    <Button Command="{Binding TestTogglePressedCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Try chat commands with a made-up message, user and badges">
                        <Panel>
                            <TextBlock Text="Test ▸" IsVisible="{Binding !IsTestOpen}"/>
                            <TextBlock Text="Test ▾" IsVisible="{Binding IsTestOpen}"/>
                        </Panel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsTestOpen}">
                        <TextBlock Classes="Label" Text="User"/>
                        <TextBox Width="120" Text="{Binding TestUser}"/>
                        <TextBlock Classes="Label" Text="Message"/>
                        <TextBox Width="220" Text="{Binding TestMessage}" PlaceholderText="e.g. !lurk">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendTestPressedCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <TextBlock Classes="Label" Text="Mod"/>
                        <CheckBox IsChecked="{Binding TestIsModerator}" VerticalAlignment="Center"/>
                        <TextBlock Classes="Label" Text="VIP"/>
                        <CheckBox IsChecked="{Binding TestIsVip}" VerticalAlignment="Center"/>
                        <TextBlock Classes="Label" Text="Sub"/>
                        <CheckBox IsChecked="{Binding TestIsSubscriber}" VerticalAlignment="Center"/>
                        <Button Content="Send" Command="{Binding SendTestPressedCommand}"
                                ToolTip.Tip="Runs the message through the chat commands (Enter in the message box does too)"/>
                        <TextBlock Classes="Description" Text="{Binding TestResult}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </Grid>

        <GridSplitter Grid.Column="1" Margin="{StaticResource ColumnSplitterMargin}" Classes="ColumnSplitter"/>

        <!-- chat block list -->

        <blocks:BlockPaletteView Grid.Column="2" DataContext="{Binding ChatPalette}"/>

    </Grid>

</UserControl>
