<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Chatbot.UI.ChatCommandsView"
             x:DataType="ui:ChatCommandsViewModel"

             xmlns:ui="using:StreamAssist.Components.Chatbot.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- chat command tree | chat block list -->

    <!-- a line under the config bar (ChatbotComponentView), then the page. Test (a made-up chat message run through
         both trees, saying which command caught it) sits right above Built-in -->

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="Divider"/>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{Binding ChatBlockListWidth, Mode=TwoWay}" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <!-- the two root chat block slots (BlockSlotViews through the ViewLocator), in the order messages try them,
                 clicking a bind box opens its binding below -->

            <ScrollViewer Grid.Row="0" Classes="Gapped"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <!-- the padding is room to scroll the last block up (Spacing.axaml ScrollEndPadding) -->
                <Border Padding="{StaticResource ScrollEndPadding}">
                    <StackPanel Spacing="{DynamicResource LargeVerticalGap}" Margin="{s:Gap ScrollInset}">
                        <!-- Test and its panel (a made-up chat message run through both trees), then the two trees, big titles and their
                             roots LargeVerticalGap apart -->
                        <StackPanel Spacing="{DynamicResource SmallVerticalGap}">
                            <Button Classes="Tab" Classes.Open="{Binding IsTestOpen}" Content="Test" HorizontalAlignment="Left"
                                    Command="{Binding TestTabPressedCommand}"/>
                            <Grid IsVisible="{Binding IsTestOpen}"
                                  ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource SmallVerticalGap}" ColumnSpacing="{DynamicResource SmallHorizontalGap}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="User" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding TestUser}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="Message" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding TestMessage}" PlaceholderText="e.g. !lurk">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SendTestPressedCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="Badges" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                                    <CheckBox IsChecked="{Binding TestIsModerator}" Content="Mod"/>
                                    <CheckBox IsChecked="{Binding TestIsVip}" Content="VIP"/>
                                    <CheckBox IsChecked="{Binding TestIsSubscriber}" Content="Sub"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                                    <Button Content="Send" Command="{Binding SendTestPressedCommand}"/>
                                    <TextBlock Classes="Description" Text="{Binding TestResult}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Classes="Title" Text="Built-in" Margin="{s:Gap BigTitleMargin}"/>
                        <ContentControl Content="{Binding Root}"/>
                        <TextBlock Classes="Title" Text="Custom" Margin="{s:Gap BigTitleMargin}"/>
                        <ContentControl Content="{Binding EditableRoot}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

        </Grid>

        <GridSplitter Grid.Column="1" Classes="ColumnSplitter"/>

        <!-- chat block list -->

        <blocks:BlockPaletteView Grid.Column="2" DataContext="{Binding ChatPalette}"/>

    </Grid>

    </DockPanel>

</UserControl>
