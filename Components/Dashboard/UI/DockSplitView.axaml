<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Dashboard.UI.DockSplitView">

    <!-- the regions and the splitters between them: the number of columns (or rows) depends on the split, so the grid
         is built in code-behind -->

    <Grid x:Name="SplitGrid"/>

</UserControl>
