<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Dashboard.UI.DockView"
             x:DataType="ui:DockViewModel"

             xmlns:ui="using:StreamAssist.Components.Dashboard.UI"
             xmlns:blocks="using:StreamAssist.Components.Blocks.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- a dock is something the user made, so it looks like a block: a green outline (red while it's off), its name box
         top-left, the edit buttons top-right (copy, on / off, drag, remove), a divider, then its body. A blank dock is
         only a grey outline (no header) with drag and remove, and a paste button in its body. While a dock or a card is dragged over it, the half it
         would go to is outlined (DropMarker, placed in code-behind) -->

    <!-- the edit buttons show only while the pointer is on the dock (hidden by opacity, so nothing moves) -->
    <UserControl.Styles>
        <Style Selector="blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border#Card:pointerover blocks|EditButtons.HoverOnly">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <!-- the card's border is a line: a LineGap ring inside it, the header ContentPadding further in (like a panel's
         header), the divider at the ring. The drop marker sits over the whole card, outside the ring -->

    <Panel Margin="{s:Gap PadAll}">
    <Border x:Name="Card" Classes="Panel" Classes.Bound="{Binding !IsBlank}" Classes.Disabled="{Binding IsDisabled}"
            DragDrop.AllowDrop="True" Padding="{s:Gap LineZoneAll}">

        <Panel>
            <DockPanel>

                <!-- name, the kind's buttons beside it, at fixed sizes: a narrow dock crops them on the right, they never
                     squeeze. The edit buttons (drag, remove) sit on top in the corner, like a block's, so they're always
                     there to use, over the header if the dock is that narrow. A divider under it, as under the window's
                     panel headers -->

                <Panel DockPanel.Dock="Top" ClipToBounds="True" IsVisible="{Binding !IsBlank}">

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" Margin="{s:Gap PadAll}" HorizontalAlignment="Left">

                        <TextBox Classes="Commit" Text="{Binding NameInput}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}"
                                 Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center"/>

                        <Button Content="Clear" Command="{Binding ClearPressedCommand}"
                                VerticalAlignment="Center" IsVisible="{Binding IsConsole}" IsEnabled="{Binding !IsDisabled}"/>

                        <!-- the lines to a .txt in Downloads (says Saved for a moment) -->
                        <Button Command="{Binding DownloadPressedCommand}" VerticalAlignment="Center" IsVisible="{Binding IsConsole}">
                            <Panel>
                                <TextBlock Classes="BoxText" Text="Download" Opacity="{Binding JustSaved, Converter={x:Static ui:DockView.HideWhenTrue}}"/>
                                <TextBlock Classes="BoxText" Text="Saved" HorizontalAlignment="Center" IsVisible="{Binding JustSaved}"/>
                            </Panel>
                        </Button>

                        <!-- indicators: flip every one (one never set turns on) -->
                        <Button Content="Toggle all" Command="{Binding Indicators.ToggleAllPressedCommand}" VerticalAlignment="Center"
                                IsVisible="{Binding Indicators, Converter={x:Static ObjectConverters.IsNotNull}}" IsEnabled="{Binding !IsDisabled}"/>

                        <!-- timers: a row's three buttons for all of them (pause shows play while all are paused), dimmed
                             while none run, then the seconds every ＋ adds (this one to all, each row's to its own) -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" VerticalAlignment="Center"
                                    IsVisible="{Binding Timers, Converter={x:Static ObjectConverters.IsNotNull}}" IsEnabled="{Binding !IsDisabled}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"
                                        Opacity="{Binding Timers.IsEmpty, Converter={x:Static ui:DockView.DimWhenTrue}, FallbackValue=1}">
                                <Button Classes="Square Medium" Command="{Binding Timers.PauseAllPressedCommand}">
                                    <Panel>
                                        <Path Classes="Icon" Data="{StaticResource PauseIcon}" IsVisible="{Binding Timers.AnyRunning, FallbackValue=False}"/>
                                        <Path Classes="Icon" Data="{StaticResource PlayIcon}" IsVisible="{Binding !Timers.AnyRunning, FallbackValue=False}"/>
                                    </Panel>
                                </Button>
                                <Button Classes="Square Medium" Command="{Binding Timers.FinishAllPressedCommand}">
                                    <Path Classes="Icon" Data="{StaticResource SkipIcon}"/>
                                </Button>
                                <Button Classes="Square Medium" Command="{Binding Timers.CancelAllPressedCommand}">
                                    <Path Classes="Icon" Data="{StaticResource StopIcon}"/>
                                </Button>
                            </StackPanel>
                            <TextBox Text="{Binding Timers.AddSeconds, FallbackValue=''}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" PlaceholderText="Seconds"
                                     Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center"/>
                            <Button Classes="Square Medium" Content="＋" Command="{Binding Timers.AddTimeAllPressedCommand}"/>
                        </StackPanel>

                        <!-- sounds: pause all (play while all are paused), skip the playing ones, stop them all (dimmed while
                             there are none), then one at a time or over each other -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" VerticalAlignment="Center"
                                    IsVisible="{Binding Sounds, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" IsEnabled="{Binding !IsDisabled}"
                                        Opacity="{Binding Sounds.IsEmpty, Converter={x:Static ui:DockView.DimWhenTrue}, FallbackValue=1}">
                                <Button Classes="Square Medium" Command="{Binding Sounds.PauseAllPressedCommand}">
                                    <Panel>
                                        <Path Classes="Icon" Data="{StaticResource PauseIcon}" IsVisible="{Binding Sounds.AnyRunning, FallbackValue=False}"/>
                                        <Path Classes="Icon" Data="{StaticResource PlayIcon}" IsVisible="{Binding !Sounds.AnyRunning, FallbackValue=False}"/>
                                    </Panel>
                                </Button>
                                <Button Classes="Square Medium" Command="{Binding Sounds.SkipPressedCommand}">
                                    <Path Classes="Icon" Data="{StaticResource SkipIcon}"/>
                                </Button>
                                <Button Classes="Square Medium" Command="{Binding Sounds.StopAllPressedCommand}">
                                    <Path Classes="Icon" Data="{StaticResource StopIcon}"/>
                                </Button>
                            </StackPanel>
                            <CheckBox Content="Wait Until Done" IsChecked="{Binding Sounds.WaitUntilDone, FallbackValue=True}"/>
                        </StackPanel>

                        <!-- buttons: press every one, top to bottom -->
                        <Button Classes="Square Medium" VerticalAlignment="Center"
                                Command="{Binding Buttons.PressAllPressedCommand}" IsEnabled="{Binding !IsDisabled}"
                                IsVisible="{Binding Buttons, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Path Classes="Icon" Data="{StaticResource PlayIcon}"/>
                        </Button>
                    </StackPanel>

                </Panel>

                <Border DockPanel.Dock="Top" Classes="Divider" IsVisible="{Binding !IsBlank}"/>

                <ContentControl Content="{Binding Body}"/>

            </DockPanel>

            <!-- over the header, out of the ring: CornerGap from the border like a block's -->
            <blocks:EditButtons Classes="HoverOnly" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{s:Gap RingCornerMargin}"/>
        </Panel>

    </Border>

    <Border x:Name="DropMarker" IsVisible="False" IsHitTestVisible="False" Background="{StaticResource PanelFillHover}"
            BorderBrush="{StaticResource Bound}" BorderThickness="{s:Gap BorderAll}" CornerRadius="{s:Gap Corners}"/>
    </Panel>

</UserControl>
