<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamAssist.Components.Data.UI.TableGridView"
             x:DataType="ui:TableGridViewModel"

             xmlns:ui="using:StreamAssist.Components.Data.UI"
        xmlns:s="using:StreamAssist.Styles">

    <!-- header: the table (rename / delete, and Delete columns mode, green while on, for custom tables), then search rows |
         a line | the grid: the id column, a line, then a column per table column (its header: name with the sort button
         over its right end, and type), an empty box after the last one to make a new column, a line under the headers, a
         row per table row, then an empty row to make a new one. A column is as wide as its header (which grows with its name), its cells take that width. Every box in the grid looks
         like plain text (a border only while typing, a type dropdown keeps its arrow), Enter or clicking away saves -->

    <UserControl.Styles>
        <Style Selector="TextBox.Cell">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- a column name: room on the right for the sort (and, in delete mode, delete) buttons over it -->
        <Style Selector="TextBox.Name">
            <Setter Property="Padding" Value="{s:Gap SortNamePadding}"/>
        </Style>
        <!-- Delete columns while it's on -->
        <Style Selector="Button.Active /template/ ContentPresenter, Button.Active:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Bound}"/>
        </Style>
        <Style Selector="ComboBox.Kind">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        </Style>
        <!-- its text the size of the cells' (the app's TextBlock style would make it bigger) -->
        <Style Selector="ComboBox.Kind TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        </Style>
        <!-- every row is a cell tall with SmallVerticalGap under it, so the id column and the cells beside it always line up -->
        <Style Selector="Grid.Row">
            <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
            <Setter Property="Margin" Value="{s:Gap SmallGapBelow}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- the table -->

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"
                    Margin="{s:Gap PadAll}" Height="{DynamicResource ControlHeight}">
            <TextBlock Classes="Label" Text="{Binding TableName}" VerticalAlignment="Center" IsVisible="{Binding !IsCustom}"/>
            <TextBox Text="{Binding TableNameInput}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center"
                     IsVisible="{Binding IsCustom}"/>
            <Button Content="Rename" Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center" Command="{Binding RenamePressedCommand}" IsVisible="{Binding IsCustom}"/>
            <Button Content="{Binding DeleteTableText}" Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center" Command="{Binding DeleteTablePressedCommand}" IsVisible="{Binding IsCustom}"/>
            <Button Content="Delete columns" Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center" Command="{Binding DeleteColumnsPressedCommand}" IsVisible="{Binding IsCustom}"
                    Classes.Active="{Binding IsDeleteColumnsMode}"/>
            <Button Content="Renumber ids" Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center" Command="{Binding RenumberPressedCommand}"/>
        </StackPanel>

        <!-- search rows (as you type) | a query (Run query or Enter applies it, see RowQuery) -->

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" Margin="{s:Gap SearchRowMargin}">
            <TextBox Text="{Binding SearchText}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center" PlaceholderText="Search rows…"/>
            <TextBox Classes="Query" Text="{Binding QueryText}" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}" Height="{DynamicResource ControlHeight}" MinHeight="0" VerticalContentAlignment="Center" PlaceholderText="Query, e.g. user:bud points>100">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding RunQueryPressedCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <Button Content="Run query" Height="{DynamicResource ControlHeight}" VerticalContentAlignment="Center" Command="{Binding RunQueryPressedCommand}"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="Divider"/>

        <!-- the grid: id | line | columns, a line under the headers -->

        <ScrollViewer Classes="Gapped" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Padding="{StaticResource ScrollEndPadding}">
                <!-- id | the vertical line (an Auto column: its style keeps LineGap either side) | the columns; what's beside the line
                     adds ContentPadding (PadRight / PadLeft), so it's ContentGap from it -->
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="{s:Gap ScrollInset}" HorizontalAlignment="Left">

                    <!-- the id header: its sort button -->
                    <Grid Grid.Row="0" Grid.Column="0" Width="50" VerticalAlignment="Top" Height="{DynamicResource ControlHeight}" Margin="{s:Gap PadRight}">
                        <TextBlock Classes="Label" Text="id" VerticalAlignment="Center"/>
                        <Button Classes="Square Small" Content="{Binding IdSortText}" Command="{Binding SortByIdPressedCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- the line between the id column and the rest, all the way down -->
                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Classes="VerticalDivider"/>

                    <!-- column headers, then the box that makes a new column -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="{s:Gap PadLeft}" Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}">
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="ui:ColumnHeaderViewModel">
                                    <!-- the column's width: the header grows with its name or the column's longest value (an invisible cell
                                         holding it, so it's measured exactly like one), between the column min and max; the cells below
                                         take its width (OnHeaderSizeChanged) -->
                                    <StackPanel MinWidth="{DynamicResource TableColumnMinWidth}" MaxWidth="{DynamicResource TableColumnMaxWidth}" Spacing="{DynamicResource SmallVerticalGap}" SizeChanged="OnHeaderSizeChanged">
                                        <Grid Height="{DynamicResource ControlHeight}">
                                            <TextBox Classes="Cell" Text="{Binding WidestText}" Opacity="0" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
                                            <TextBox Classes="Cell Name Commit" Classes.Plain="{Binding !IsEditable}" Text="{Binding NameInput}" IsReadOnly="{Binding !IsEditable}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{s:Gap SortButtonsMargin}">
                                                <Button Classes="Square Small" Content="－" Command="{Binding DeletePressedCommand}" IsVisible="{Binding IsDeleteMode}"/>
                                                <Button Classes="Square Small" Content="{Binding SortText}" Command="{Binding SortPressedCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox Classes="Kind" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindName}" IsVisible="{Binding IsEditable}"/>
                                        <TextBlock Classes="Description" Text="{Binding KindName}" IsVisible="{Binding !IsEditable}" Margin="{s:Gap BoxTextMargin}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Classes="Cell New Commit" Text="{Binding NewColumnName}" PlaceholderText="New column…" MinWidth="{DynamicResource ControlMinWidth}" MaxWidth="{DynamicResource ControlMaxWidth}"
                                 VerticalAlignment="Top" IsVisible="{Binding IsCustom}"/>
                    </StackPanel>

                    <!-- the line under the headers, ContentGap from them and from the first row's boxes -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="Divider" Margin="{s:Gap TableHeaderLineMargin}"/>

                    <!-- the ids -->
                    <ItemsControl Grid.Row="2" Grid.Column="0" Width="50" Margin="{s:Gap PadRight}" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:RowViewModel">
                                <Grid Classes="Row">
                                    <TextBlock Classes="Description" Text="{Binding Id}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- the cells, a − at the end of each row deletes it -->
                    <ItemsControl Grid.Row="2" Grid.Column="2" Margin="{s:Gap PadLeft}" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:RowViewModel">
                                <Grid Classes="Row" ColumnDefinitions="Auto,Auto">
                                    <ItemsControl ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="ui:CellViewModel">
                                                <TextBox Classes="Cell Commit" Text="{Binding Text}" Width="{Binding Header.Width}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Column="1" Classes="Square Small" Content="－" Command="{Binding DeletePressedCommand}"
                                            VerticalAlignment="Center" Margin="{s:Gap SmallGapBefore}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- the empty row: a value typed in any of its cells makes a new row (no id until then) -->
                    <Grid Grid.Row="3" Grid.Column="0" Classes="Row"/>
                    <ItemsControl Grid.Row="3" Grid.Column="2" Margin="{s:Gap PadLeft}" ItemsSource="{Binding NewRowCells}" VerticalAlignment="Top" Height="{DynamicResource ControlHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SmallHorizontalGap}" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:CellViewModel">
                                <TextBox Classes="Cell New Commit" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" Width="{Binding Header.Width}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>
