using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.Json.Serialization;
using System.Threading.Tasks;

namespace StreamAssist.Components.StreamAction;

public class ActionGroupModel
{
    [JsonPropertyName("name")]
    public string Name { get; set; } = "";

    [JsonIgnore]
    public IReadOnlyList<IStreamAction> Actions => _actions;
    private readonly List<IStreamAction> _actions = [];

    [JsonInclude]
    [JsonPropertyName("actions")]
    private List<ActionBindingData> PendingActions
    {
        get => _actions.Select(ActionResolver.GetKey).ToList();
        set
        {
            _actions.Clear();
            foreach (var data in value)
            {
                var action = ActionResolver.Resolve(data);
                if (action is not null)
                    _actions.Add(action);
            }
        }
    }

    public event Action? ActionsChanged;

    public void AddAction(IStreamAction action)
    {
        _actions.Add(action);
        ActionsChanged?.Invoke();
    }

    public bool RemoveAction(IStreamAction action)
    {
        if (!_actions.Remove(action)) return false;
        ActionsChanged?.Invoke();
        return true;
    }

    public async Task ExecuteAllAsync()
    {
        foreach (var action in _actions)
            await action.SafeExecuteAsync();
    }
}